---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import LatestBlog from '../../components/astro/LatestBlog.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Плагин AI Wiki для Obsidian | Автосвязанные заметки';
const description = "Превратите заметки Obsidian в самоорганизующуюся вики. Karpathy LLM Wiki автоматически извлекает сущности, строит двусторонние ссылки и позволяет искать знания на естественном языке — бесплатно, локально, с открытым кодом.";
const keywords = 'Karpathy LLM Wiki, плагин Obsidian AI, плагин Obsidian Wiki, база знаний AI, двусторонние ссылки, AI заметки, самоорганизующиеся заметки, локальный AI, плагин Obsidian с открытым кодом, вики Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="ru" ogLocale="ru_RU" hasFaq hasHowTo>
  <Hero locale="ru" />
  <Comparison locale="ru" />
  <WikiDemoIsland client:visible locale="ru" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="ru" />
  <LatestBlog locale="ru" />
  <Install locale="ru" />
  <FAQ locale="ru" />
  <Ecosystem locale="ru" />
  <Providers locale="ru" />
  <CTA locale="ru" />
</BaseLayout>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import LatestBlog from '../../components/astro/LatestBlog.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Obsidian AI Wiki 플러그인｜자동 연결 노트';
const description = "Obsidian 노트를 자기 조직화 위키로 만드세요. Karpathy LLM Wiki 는 엔티티를 자동 추출하고, 양방향 링크를 구축하며, 자연어로 지식을 검색합니다——묵료, 로컬 우선, 오픈소스.";
const keywords = 'Karpathy LLM Wiki, Obsidian AI 플러그인, Obsidian Wiki 플러그인, AI 지식 베이스, 양방향 링크, AI 노트, 자기 조직화 노트, 로컬 우선 AI, 오픈소스 Obsidian 플러그인, 마크다운 위키';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="ko" ogLocale="ko_KR" hasFaq hasHowTo>
  <Hero locale="ko" />
  <Comparison locale="ko" />
  <WikiDemoIsland client:visible locale="ko" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="ko" />
  <LatestBlog locale="ko" />
  <Install locale="ko" />
  <FAQ locale="ko" />
  <Ecosystem locale="ko" />
  <Providers locale="ko" />
  <CTA locale="ko" />
</BaseLayout>

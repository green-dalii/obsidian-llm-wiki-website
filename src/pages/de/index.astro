---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — KI-gestützte selbstorganisierende Wissensdatenbank';
const description = "Karpathys LLM Wiki für Obsidian — die KI liest Ihre Notizen und erstellt ein vernetztes Wiki mit Entitäts-/Konzeptseiten, bidirektionalen Links und dialogbasierter Abfrage.";
const keywords = 'Obsidian Plugin, LLM Wiki, KI Wissensmanagement, Wissensgraph, bidirektionale Links, Notizen, KI Wiki, selbstorganisierende Notizen, Karpathy, Obsidian KI, Markdown Wiki';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="de" ogLocale="de_DE" hasFaq>
  <Hero locale="de" />
  <Comparison locale="de" />
  <WikiDemoIsland client:visible locale="de" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="de" />
  <Install locale="de" />
  <FAQ locale="de" />
  <Ecosystem locale="de" />
  <Providers locale="de" />
  <CTA locale="de" />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import LatestBlog from '../../components/astro/LatestBlog.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Trust from '../../components/astro/Trust.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — AI-Wiki-Plugin für Obsidian | Automatisch verlinkte Notizen';
const description = "Verwandeln Sie Ihre Obsidian-Notizen in ein selbstorganisierendes Wiki. Karpathy LLM Wiki extrahiert Entitäten automatisch, baut bidirektionale Links auf und lässt Sie Ihr Wissen in natürlicher Sprache abfragen — kostenlos, lokal-first, Open Source.";
const keywords = 'Karpathy LLM Wiki, Obsidian AI Plugin, Obsidian Wiki Plugin, AI Wissensdatenbank, bidirektionale Links, KI Notizen, selbstorganisierende Notizen, lokal-first KI, Open Source Obsidian Plugin, Markdown Wiki';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="de" ogLocale="de_DE" hasFaq hasHowTo>
  <Hero locale="de" />
  <Comparison locale="de" />
  <WikiDemoIsland client:visible locale="de" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="de" />
  <LatestBlog locale="de" />
  <Install locale="de" />
  <FAQ locale="de" />
  <Trust locale="de" />
  <Ecosystem locale="de" />
  <Providers locale="de" />
  <CTA locale="de" />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/astro/Hero.astro';
import Comparison from '../components/astro/Comparison.astro';
import WikiDemoIsland from '../components/WikiDemoIsland';
import Features from '../components/astro/Features.astro';
import Install from '../components/astro/Install.astro';
import FAQ from '../components/astro/FAQ.astro';
import Ecosystem from '../components/astro/Ecosystem.astro';
import Providers from '../components/astro/Providers.astro';
import CTA from '../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — AI Wiki Plugin for Obsidian | Auto-Linked Notes';
const description = "Turn your Obsidian notes into a self-organizing wiki. Karpathy LLM Wiki auto-extracts entities, builds bidirectional links, and lets you query your knowledge in plain English — free, local-first, open source.";
const keywords = 'Karpathy LLM Wiki, Obsidian AI plugin, Obsidian wiki plugin, AI knowledge base, bidirectional links, note-taking AI, self-organizing notes, local-first AI, open source Obsidian plugin, markdown wiki';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="en" ogLocale="en_US" hasFaq>
  <Fragment slot="head">
    <script is:inline>
      // Auto-redirect to localized page based on browser language
      (function () {
        if (window.location.pathname !== '/') return;
        try { if (sessionStorage.getItem('lang-routed')) return; } catch (e) {}

        var lang = (navigator.language || '').toLowerCase();
        var map = { zh: '/zh/', ja: '/ja/', ko: '/ko/', de: '/de/', es: '/es/', fr: '/fr/', pt: '/pt/', it: '/it/', ru: '/ru/' };
        // zh-tw / zh-hk / zh-mo -> Traditional Chinese variant page
        var isTraditional = /^zh-(tw|hk|hk|mo)\b/i.test(lang);
        var code = lang.split('-')[0];
        var target = isTraditional ? '/zh-tw/' : map[code];

        if (target && code !== 'en') {
          try { sessionStorage.setItem('lang-routed', '1'); } catch (e) {}
          window.location.replace(target);
        }
      })();
    </script>
  </Fragment>

  <Hero locale="en" />
  <Comparison locale="en" />
  <WikiDemoIsland client:visible locale="en" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="en" />
  <Install locale="en" />
  <FAQ locale="en" />
  <Ecosystem locale="en" />
  <Providers locale="en" />
  <CTA locale="en" />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Obsidian AI Wiki 插件｜自动链接笔记';
const description = "把 Obsidian 笔记变成一部自组织 Wiki。Karpathy LLM Wiki 自动提取实体、构建双向链接、用自然语言查询你的知识库——免费、本地优先、开源。";
const keywords = 'Karpathy LLM Wiki, Obsidian AI 插件, Obsidian Wiki 插件, AI 知识库, 双向链接, AI 笔记, 自组织笔记, 本地优先 AI, 开源 Obsidian 插件, Markdown 知识库';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="zh" ogLocale="zh_CN" hasFaq hasHowTo>
  <Hero locale="zh" />
  <Comparison locale="zh" />
  <WikiDemoIsland client:visible locale="zh" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="zh" />
  <Install locale="zh" />
  <FAQ locale="zh" />
  <Ecosystem locale="zh" />
  <Providers locale="zh" />
  <CTA locale="zh" />
</BaseLayout>

---
import '../../index.css';
import ProgressBar from '../../components/ProgressBar';
import HeaderIsland from '../../components/HeaderIsland';
import HeroIsland from '../../components/HeroIsland';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Footer from '../../components/astro/Footer.astro';
import Comparison from '../../components/astro/Comparison.astro';
import Features from '../../components/astro/Features.astro';
import Install from '../../components/astro/Install.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const siteUrl = Astro.site;
const title = 'LLM Wiki for Obsidian — AI驱动的自组织知识库';
const description = 'Karpathy LLM Wiki 的 Obsidian 实现——AI 读取你的笔记，生成包含实体/概念页面、双向链接和对话查询的互联 Wiki。';
const ogImage = siteUrl + 'og-image.webp';
const zhUrl = siteUrl + 'zh/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Obsidian 插件, LLM Wiki, AI 知识管理, 知识图谱, 双向链接, 笔记, AI wiki, 自组织笔记, Andrej Karpathy, Obsidian AI, markdown wiki" />
    <meta name="author" content="Greener-Dalii" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="application-name" content="LLM Wiki for Obsidian" />
    <meta name="apple-mobile-web-app-title" content="LLM Wiki for Obsidian" />
    <meta name="msapplication-TileColor" content="#1a1a1a" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Font preload -->
    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LLM Wiki for Obsidian" />
    <meta property="og:url" content={zhUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GreenerDalii" />
    <meta name="twitter:creator" content="@GreenerDalii" />
    <meta name="twitter:title" content="LLM Wiki for Obsidian" />
    <meta name="twitter:description" content="Karpathy LLM Wiki 的 Obsidian 实现。你书写，AI 组织，你提问。" />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": siteUrl + "zh/#website",
          "name": "LLM Wiki for Obsidian",
          "url": siteUrl + "zh/",
          "description": description,
          "publisher": { "@type": "Person", "name": "Greener-Dalii" }
        },
        {
          "@type": "SoftwareApplication",
          "@id": siteUrl + "zh/#software",
          "name": "LLM Wiki for Obsidian",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Cross-platform",
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
          "license": "https://opensource.org/licenses/MIT",
          "author": { "@type": "Person", "name": "Greener-Dalii", "url": "https://github.com/green-dalii" },
          "codeRepository": "https://github.com/green-dalii/obsidian-llm-wiki",
          "downloadUrl": "https://github.com/green-dalii/obsidian-llm-wiki/releases",
          "softwareVersion": "1.3.1",
          "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5", "ratingCount": "1" },
          "featureList": [
            "Auto-organize notes into structured wiki pages",
            "Bidirectional linking between knowledge entities",
            "Conversational query with cited answers",
            "Auto maintenance with file watcher",
            "Multi-provider LLM support",
            "Full-context ingestion"
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "zh/" }
          ]
        }
      ]
    })} />

    <!-- Canonical -->
    <link rel="canonical" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={Astro.site} />
    <link rel="alternate" hreflang="zh" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={Astro.site} />
  </head>
  <body>
    <div class="relative bg-obsidian-bg text-obsidian-text">
      <ProgressBar client:only="react" />
      <HeaderIsland client:only="react" currentLocale="zh" />
      <main class="pt-14">
        <HeroIsland client:only="react" locale="zh" />
        <Comparison locale="zh" />
        <WikiDemoIsland client:only="react" locale="zh" />
        <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
        <Features locale="zh" />
        <Install locale="zh" />
        <Ecosystem locale="zh" />
        <Providers locale="zh" />
        <CTA locale="zh" />
      </main>
      <Footer locale="zh" />
    </div>
  </body>
</html>

<script src="../../scripts/scroll-reveal.ts"></script>
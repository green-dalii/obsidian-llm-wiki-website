---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';

const allPosts = await getCollection('blog-zh');
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort();
---

<BlogLayout title="博客" description="关于 Karpathy LLM Wiki 的更新、教程和深度解析。" locale="zh">
  <section class="relative w-full py-28 sm:py-36 reveal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="mb-14 reveal text-center">
        <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">Blog</span>
        <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-obsidian-heading reveal" data-delay="1">最新动态</h2>
        <p class="text-obsidian-muted max-w-lg mx-auto text-sm">关于插件和 Karpathy LLM Wiki 理念的更新、教程与深度解析。</p>
      </div>

      {allTags.length > 0 && (
        <div class="mb-10 flex flex-wrap gap-2 justify-center" id="tag-filters">
          <button data-tag="" class="tag-btn text-[11px] px-3 py-1 rounded-full bg-obsidian-purple/15 text-obsidian-purple-light border border-obsidian-purple/30 transition-colors">全部</button>
          {allTags.map(tag => (
            <button data-tag={tag} class="tag-btn text-[11px] px-3 py-1 rounded-full bg-obsidian-surface text-obsidian-muted border border-obsidian-border hover:border-obsidian-purple/30 hover:text-obsidian-heading transition-colors">{tag}</button>
          ))}
        </div>
      )}

      <p class="text-sm text-obsidian-muted text-center mb-6 hidden" id="filter-count"></p>

      <div class="flex flex-col gap-3" id="post-list">
        {posts.map((post, i) => (
          <a href={`/zh/blog/posts/${post.id}/`} data-tags={JSON.stringify(post.data.tags || [])} class="post-card">
            <article class="card card-hover reveal p-5 sm:p-6" data-delay={i * 2}>
              <time class="text-[11px] font-mono text-obsidian-dim block mb-2">{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              <h3 class="text-base font-semibold text-obsidian-heading mb-1.5">{post.data.title}</h3>
              <p class="text-sm text-obsidian-muted leading-relaxed mb-3">{post.data.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {(post.data.tags || []).map(tag => (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light">{tag}</span>
                ))}
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</BlogLayout>

<script is:inline>
(function() {
  var btns = document.querySelectorAll('.tag-btn');
  var cards = document.querySelectorAll('.post-card');
  var count = document.getElementById('filter-count');

  function filter(tag) {
    var active = 0;
    btns.forEach(function(b) {
      var isActive = b.dataset.tag === tag;
      b.classList.toggle('bg-obsidian-purple/15', isActive);
      b.classList.toggle('text-obsidian-purple-light', isActive);
      b.classList.toggle('border-obsidian-purple/30', isActive);
      b.classList.toggle('bg-obsidian-surface', !isActive);
      b.classList.toggle('text-obsidian-muted', !isActive);
      b.classList.toggle('border-obsidian-border', !isActive);
    });
    cards.forEach(function(c) {
      try {
        var tags = JSON.parse(c.dataset.tags || '[]');
        var show = !tag || tags.indexOf(tag) >= 0;
        c.style.display = show ? '' : 'none';
        if (show) active++;
      } catch(e) {}
    });
    if (tag) {
      count.classList.remove('hidden');
      count.textContent = active + ' 篇文章标记为 "' + tag + '"';
    } else {
      count.classList.add('hidden');
    }
  }

  var params = new URLSearchParams(window.location.search);
  var t = params.get('tag') || '';
  filter(t);

  btns.forEach(function(b) {
    b.addEventListener('click', function() {
      var tag = b.dataset.tag;
      var url = tag ? '/zh/blog/?tag=' + encodeURIComponent(tag) : '/zh/blog/';
      history.pushState(null, '', url);
      filter(tag);
    });
  });

  window.addEventListener('popstate', function() {
    var p = new URLSearchParams(window.location.search);
    filter(p.get('tag') || '');
  });
})();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import LatestBlog from '../../components/astro/LatestBlog.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Obsidian AI Wiki 外掛｜自動連結筆記';
const description = "把 Obsidian 筆記變成一部自組織 Wiki。Karpathy LLM Wiki 自動萃取實體、建立雙向連結、用自然語言查詢你的知識庫——免費、本機優先、開源。";
const keywords = 'Karpathy LLM Wiki, Obsidian AI 外掛, Obsidian Wiki 外掛, AI 知識庫, 雙向連結, AI 筆記, 自組織筆記, 本機優先 AI, 開源 Obsidian 外掛, Markdown 知識庫';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="zh-tw" ogLocale="zh_TW" hasFaq hasHowTo>
  <Hero locale="zh-tw" />
  <Comparison locale="zh-tw" />
  <WikiDemoIsland client:visible locale="zh-tw" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="zh-tw" />
  <LatestBlog locale="zh-tw" />
  <Install locale="zh-tw" />
  <FAQ locale="zh-tw" />
  <Ecosystem locale="zh-tw" />
  <Providers locale="zh-tw" />
  <CTA locale="zh-tw" />
</BaseLayout>
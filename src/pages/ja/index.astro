---
import '../../index.css';
import ProgressBar from '../../components/ProgressBar';
import HeaderIsland from '../../components/HeaderIsland';
import Hero from '../../components/astro/Hero.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Footer from '../../components/astro/Footer.astro';
import Comparison from '../../components/astro/Comparison.astro';
import Features from '../../components/astro/Features.astro';
import Install from '../../components/astro/Install.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const siteUrl = Astro.site;
const title = 'LLM Wiki for Obsidian — AI駆動の自己組織化知識ベース';
const description = 'Karpathy LLM WikiのObsidian実装——AIがノートを読み込み、エンティティ/コンセプトページ、双方向リンク、会話型クエリを備えたつながるWikiを生成します。';
const ogImage = siteUrl + 'og-image.webp';
const pageUrl = siteUrl + 'ja/';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Obsidian プラグイン, LLM Wiki, AI 知識管理, 知識グラフ, 双方向リンク, AI ノート, 自己組織化 Wiki, Andrej Karpathy, Obsidian AI, スマート修復, 重複検出, 多言語 Wiki" />
    <meta name="author" content="Greener-Dalii" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="application-name" content="LLM Wiki for Obsidian" />
    <meta name="apple-mobile-web-app-title" content="LLM Wiki for Obsidian" />
    <meta name="msapplication-TileColor" content="#1a1a1a" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Font preload -->
    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LLM Wiki for Obsidian" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="LLM Wiki for Obsidian — plugin banner" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GreenerDalii" />
    <meta name="twitter:creator" content="@GreenerDalii" />
    <meta name="twitter:title" content="LLM Wiki for Obsidian" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": siteUrl + "ja/#website",
          "name": "LLM Wiki for Obsidian",
          "url": pageUrl,
          "description": description,
          "publisher": { "@type": "Person", "name": "Greener-Dalii" }
        },
        {
          "@type": "SoftwareApplication",
          "@id": siteUrl + "ja/#software",
          "name": "LLM Wiki for Obsidian",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Cross-platform",
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
          "license": "https://opensource.org/licenses/MIT",
          "author": { "@type": "Person", "name": "Greener-Dalii", "url": "https://github.com/green-dalii" },
          "codeRepository": "https://github.com/green-dalii/obsidian-llm-wiki",
          "downloadUrl": "https://community.obsidian.md/plugins/karpathywiki",
          "softwareVersion": "1.8.1",
          "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5", "ratingCount": "1" },
          "featureList": [
            "AI-powered entity and concept extraction from notes",
            "Bidirectional wiki-links between knowledge pages",
            "Conversational query with streaming Markdown and citations",
            "Auto-maintenance with file watcher and periodic lint",
            "8-language Wiki output independent from UI language",
            "Cross-language duplicate detection and intelligent merge"
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": pageUrl }
          ]
        }
      ]
    })} />

    <!-- Canonical -->
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={Astro.site} />
    <link rel="alternate" hreflang="zh" href={siteUrl + 'zh/'} />
    <link rel="alternate" hreflang="ja" href={pageUrl} />
    <link rel="alternate" hreflang="ko" href={siteUrl + 'ko/'} />
    <link rel="alternate" hreflang="de" href={siteUrl + 'de/'} />
    <link rel="alternate" hreflang="es" href={siteUrl + 'es/'} />
    <link rel="alternate" hreflang="x-default" href={Astro.site} />
  </head>
  <body>
    <div class="relative bg-obsidian-bg text-obsidian-text">
      <ProgressBar client:only="react" />
      <HeaderIsland client:only="react" currentLocale="ja" />
      <main class="pt-14">
        <Hero locale="ja" />
        <Comparison locale="ja" />
        <WikiDemoIsland client:visible locale="ja" />
        <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
        <Features locale="ja" />
        <Install locale="ja" />
        <Ecosystem locale="ja" />
        <Providers locale="ja" />
        <CTA locale="ja" />
      </main>
      <Footer locale="ja" />
    </div>
  </body>
</html>

<script src="../../scripts/scroll-reveal.ts"></script>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import LatestBlog from '../../components/astro/LatestBlog.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Trust from '../../components/astro/Trust.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Obsidian AI Wiki プラグイン｜自動リンクノート';
const description = "Obsidian のノートを自己組織化 Wiki に変換。Karpathy LLM Wiki はエンティティを自動抽出し、双方向リンクを構築し、自然言語で知識を検索——無料、ローカル優先、オープンソース。";
const keywords = 'Karpathy LLM Wiki, Obsidian AI プラグイン, Obsidian Wiki プラグイン, AI ナレッジベース, 双方向リンク, AI ノート, 自己組織化ノート, ローカル優先 AI, オープンソース Obsidian プラグイン, Markdown Wiki';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="ja" ogLocale="ja_JP" hasFaq hasHowTo>
  <Hero locale="ja" />
  <Comparison locale="ja" />
  <WikiDemoIsland client:visible locale="ja" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="ja" />
  <LatestBlog locale="ja" />
  <Install locale="ja" />
  <FAQ locale="ja" />
  <Trust locale="ja" />
  <Ecosystem locale="ja" />
  <Providers locale="ja" />
  <CTA locale="ja" />
</BaseLayout>

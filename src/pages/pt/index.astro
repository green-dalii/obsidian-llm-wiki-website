---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import Trust from '../../components/astro/Trust.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Base de conhecimento auto-organizada por IA';
const description = "Implementação do LLM Wiki de Karpathy para Obsidian — a IA lê suas anotações e gera uma wiki conectada com páginas de entidades/conceitos, links bidirecionais e consulta conversacional.";
const keywords = 'plugin Obsidian, LLM Wiki, gestão do conhecimento com IA, grafo de conhecimento, links bidirecionais, anotações, wiki com IA, anotações auto-organizadas, Karpathy, Obsidian IA, wiki Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="pt" ogLocale="pt_BR" hasFaq>
  <Hero locale="pt" />
  <Comparison locale="pt" />
  <WikiDemoIsland client:visible locale="pt" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="pt" />
  <Trust locale="pt" />
  <Install locale="pt" />
  <FAQ locale="pt" />
  <Ecosystem locale="pt" />
  <Providers locale="pt" />
  <CTA locale="pt" />
</BaseLayout>

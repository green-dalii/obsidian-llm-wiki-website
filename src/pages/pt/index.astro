---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import LatestBlog from '../../components/astro/LatestBlog.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Plugin Wiki IA para Obsidian | Notas auto-conectadas';
const description = "Transforme suas anotações do Obsidian em uma wiki auto-organizada. Karpathy LLM Wiki extrai entidades automaticamente, cria links bidirecionais e permite consultar seu conhecimento em linguagem natural — grátis, local-first, código aberto.";
const keywords = 'Karpathy LLM Wiki, plugin Obsidian IA, plugin Obsidian Wiki, base de conhecimento IA, links bidirecionais, notas IA, notas auto-organizadas, IA local-first, plugin Obsidian código aberto, wiki Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="pt" ogLocale="pt_BR" hasFaq hasHowTo>
  <Hero locale="pt" />
  <Comparison locale="pt" />
  <WikiDemoIsland client:visible locale="pt" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="pt" />
  <LatestBlog locale="pt" />
  <Install locale="pt" />
  <FAQ locale="pt" />
  <Ecosystem locale="pt" />
  <Providers locale="pt" />
  <CTA locale="pt" />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Plugin Wiki AI per Obsidian | Note auto-collegate';
const description = "Trasforma i tuoi appunti Obsidian in una wiki auto-organizzata. Karpathy LLM Wiki estrae entità automaticamente, costruisce link bidirezionali e ti permette di interrogare la tua conoscenza in linguaggio naturale — gratuito, local-first, open source.";
const keywords = 'Karpathy LLM Wiki, plugin Obsidian IA, plugin Obsidian Wiki, base di conoscenza IA, link bidirezionali, note IA, note auto-organizzanti, IA local-first, plugin Obsidian open source, wiki Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="it" ogLocale="it_IT" hasFaq hasHowTo>
  <Hero locale="it" />
  <Comparison locale="it" />
  <WikiDemoIsland client:visible locale="it" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="it" />
  <Install locale="it" />
  <FAQ locale="it" />
  <Ecosystem locale="it" />
  <Providers locale="it" />
  <CTA locale="it" />
</BaseLayout>
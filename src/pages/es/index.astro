---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import Trust from '../../components/astro/Trust.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Base de conocimiento autoorganizada con IA';
const description = "Implementación del LLM Wiki de Karpathy para Obsidian — la IA lee tus notas y genera una wiki conectada con páginas de entidades/conceptos, enlaces bidireccionales y consulta conversacional.";
const keywords = 'plugin Obsidian, LLM Wiki, gestión del conocimiento con IA, grafo de conocimiento, enlaces bidireccionales, notas, wiki con IA, notas autoorganizadas, Karpathy, Obsidian IA, wiki Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="es" ogLocale="es_ES" hasFaq>
  <Hero locale="es" />
  <Comparison locale="es" />
  <WikiDemoIsland client:visible locale="es" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="es" />
  <Trust locale="es" />
  <Install locale="es" />
  <FAQ locale="es" />
  <Ecosystem locale="es" />
  <Providers locale="es" />
  <CTA locale="es" />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Plugin Wiki IA para Obsidian | Notas autoenlazadas';
const description = "Convierte tus notas de Obsidian en una wiki autoorganizada. Karpathy LLM Wiki extrae entidades automáticamente, crea enlaces bidireccionales y permite consultar tu conocimiento en lenguaje natural — gratis, local-first, código abierto.";
const keywords = 'Karpathy LLM Wiki, plugin Obsidian IA, plugin Obsidian Wiki, base de conocimiento IA, enlaces bidireccionales, notas IA, notas autoorganizadas, IA local-first, plugin Obsidian código abierto, wiki Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="es" ogLocale="es_ES" hasFaq hasHowTo>
  <Hero locale="es" />
  <Comparison locale="es" />
  <WikiDemoIsland client:visible locale="es" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="es" />
  <Install locale="es" />
  <FAQ locale="es" />
  <Ecosystem locale="es" />
  <Providers locale="es" />
  <CTA locale="es" />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import LatestBlog from '../../components/astro/LatestBlog.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Plugin Wiki IA pour Obsidian | Notes auto-liées';
const description = "Transformez vos notes Obsidian en un wiki auto-organisé. Karpathy LLM Wiki extrait automatiquement les entités, construit des liens bidirectionnels et vous permet d'interroger vos connaissances en langage naturel — gratuit, local-first, open source.";
const keywords = 'Karpathy LLM Wiki, plugin Obsidian IA, plugin Obsidian Wiki, base de connaissances IA, liens bidirectionnels, notes IA, notes auto-organisées, IA local-first, plugin Obsidian open source, wiki Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="fr" ogLocale="fr_FR" hasFaq hasHowTo>
  <Hero locale="fr" />
  <Comparison locale="fr" />
  <WikiDemoIsland client:visible locale="fr" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="fr" />
  <LatestBlog locale="fr" />
  <Install locale="fr" />
  <FAQ locale="fr" />
  <Ecosystem locale="fr" />
  <Providers locale="fr" />
  <CTA locale="fr" />
</BaseLayout>

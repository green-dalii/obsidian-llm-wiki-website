---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/astro/Hero.astro';
import Comparison from '../../components/astro/Comparison.astro';
import WikiDemoIsland from '../../components/WikiDemoIsland';
import Features from '../../components/astro/Features.astro';
import Trust from '../../components/astro/Trust.astro';
import Install from '../../components/astro/Install.astro';
import FAQ from '../../components/astro/FAQ.astro';
import Ecosystem from '../../components/astro/Ecosystem.astro';
import Providers from '../../components/astro/Providers.astro';
import CTA from '../../components/astro/CTA.astro';

const title = 'Karpathy LLM Wiki — Base de connaissances auto-organisée par IA';
const description = "Implémentation du LLM Wiki de Karpathy pour Obsidian — l'IA lit vos notes et génère un wiki connecté avec des pages d'entités/concepts, des liens bidirectionnels et une requête conversationnelle.";
const keywords = 'plugin Obsidian, LLM Wiki, gestion des connaissances IA, graphe de connaissances, liens bidirectionnels, prise de notes, wiki IA, notes auto-organisées, Karpathy, Obsidian IA, wiki Markdown';
---

<BaseLayout title={title} description={description} keywords={keywords} locale="fr" ogLocale="fr_FR" hasFaq>
  <Hero locale="fr" />
  <Comparison locale="fr" />
  <WikiDemoIsland client:visible locale="fr" />
  <div class="h-px max-w-5xl mx-auto bg-gradient-to-r from-transparent via-obsidian-purple/20 to-transparent" />
  <Features locale="fr" />
  <Trust locale="fr" />
  <Install locale="fr" />
  <FAQ locale="fr" />
  <Ecosystem locale="fr" />
  <Providers locale="fr" />
  <CTA locale="fr" />
</BaseLayout>

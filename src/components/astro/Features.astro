---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const tMap: Record<string, any> = translations; const t = tMap[locale] || translations.en;

// Features grid.
//
// Eight identical cards was the clearest "template" signal on the page: a flat
// wall of equal elements with no entry point. The layout is now a bento — one
// large tile carrying the claim that actually differentiates (retrieval reads
// the whole page, not its title), surrounded by supporting tiles.
//
// By device:
//   mobile  (< sm): priority 1-4 only, single column
//   sm      (sm+):  2 columns, same four
//   md+     (md+):  bento — the marquee tile spans 2x2, the last spans 2x1,
//                   so the 4-column grid closes with no empty cell
//
// Cards demoted on mobile surface as chips below, unchanged from before.
const features = [
  // The marquee claim, and the one tile that gets more room than the others.
  { title: t.features.conversationalTitle, tag: t.features.conversationalTag, desc: t.features.conversationalDesc, icon: 'message-square', priority: 1, size: 'hero' },
  { title: t.features.organizeTitle, tag: t.features.organizeTag, desc: t.features.organizeDesc, icon: 'layers', priority: 2, size: 'std' },
  { title: t.features.autoMaintenanceTitle, tag: t.features.autoMaintenanceTag, desc: t.features.autoMaintenanceDesc, icon: 'refresh-cw', priority: 3, size: 'std' },
  { title: t.features.smartFixTitle, tag: t.features.smartFixTag, desc: t.features.smartFixDesc, icon: 'zap', priority: 4, size: 'std' },
  { title: t.features.multiFileTitle, tag: t.features.multiFileTag, desc: t.features.multiFileDesc, icon: 'files', priority: 5, size: 'std' },
  { title: t.features.citationsTitle, tag: t.features.citationsTag, desc: t.features.citationsDesc, icon: 'quote', priority: 6, size: 'std' },
  // PDF Ingest (v1.25.0) — first-class source alongside Markdown.
  { title: t.features.pdfIngestTitle, tag: t.features.pdfIngestTag, desc: t.features.pdfIngestDesc, icon: 'file-text', priority: 7, size: 'std' },
  // Finalized — user-owned content stays user-owned. Closes the grid.
  { title: t.features.finalizedTitle, tag: t.features.finalizedTag, desc: t.features.finalizedDesc, icon: 'lock', priority: 8, size: 'wide' },
];

// Bidirectional links + history + granularity + tags: always chips (never a card).
// Bidirectional / history / granularity demoted to chip-only in v1.23 / v1.25.0;
// `tags` demoted to chip in v1.25.3-web when the Features grid shrunk to 8 cards.
// `perTaskModelsTitle` (v1.24.0) is EN-only; if the locale doesn't supply
// it, we silently skip the chip.
const alwaysChips: { title: string; tag: string }[] = [
  { title: t.features.bidirectionalTitle, tag: t.features.bidirectionalTag },
  { title: t.features.historyTitle, tag: t.features.historyTag },
  { title: t.features.granularityTitle, tag: t.features.granularityTag },
  { title: t.features.tagsTitle, tag: t.features.tagsTag },
];
if (t.features.perTaskModelsTitle) {
  alwaysChips.push({ title: t.features.perTaskModelsTitle, tag: '' });
}

const moreCaps = t.features.moreCapabilities || [];

const SPAN: Record<string, string> = {
  hero: 'md:col-span-2 md:row-span-2',
  std: '',
  wide: 'md:col-span-2',
};

// mobile 4 / sm+ 8, as before.
const visFor = (p: number): string => (p <= 4 ? '' : 'hidden sm:block');
const chipVisFor = (p: number): string => (p <= 4 ? 'hidden' : 'sm:hidden');
---

<section id="features" class="relative w-full py-section-std reveal">
  <div class="max-w-[1180px] mx-auto px-6 sm:px-8">
    <div class="mb-14 reveal">
      <span class="text-label font-mono text-accent uppercase">{t.features.label}</span>
      <h2 class="text-display-l font-display mt-3 mb-4 text-ink reveal" data-delay="1">{t.features.title}</h2>
      <p class="text-ink-2 max-w-[46ch] text-[0.9375rem]">{t.features.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      {features.map((f) => (
        <article
          class={[
            'feature-card group card card-hover reveal flex flex-col',
            SPAN[f.size],
            visFor(f.priority),
            f.size === 'hero' ? 'p-6 sm:p-8 justify-between min-h-[13rem] md:min-h-[20rem]' : '',
            f.size === 'std' ? 'p-5 sm:p-6' : '',
            f.size === 'wide' ? 'p-5 sm:p-6 md:justify-center' : '',
          ].join(' ')}
          data-delay={f.priority * 2}
        >
          <div class="flex items-center gap-2.5 mb-4">
            <span class="w-7 h-7 rounded-sm border border-line bg-surface-2 flex items-center justify-center text-ink-2 group-hover:text-accent group-hover:border-accent-line transition-colors duration-200">
              <Icon name={f.icon} class="w-3.5 h-3.5" />
            </span>
            <span class="text-label font-mono text-ink-3 uppercase">{f.tag}</span>
          </div>

          {f.size === 'hero' ? (
            <div class="mt-auto">
              <h3 class="text-display-m font-display text-ink max-w-[20ch] mb-3">{f.title}</h3>
              <p class="text-[0.9375rem] text-ink-2 leading-relaxed max-w-[38ch]">{f.desc}</p>
            </div>
          ) : (
            <>
              <h3 class="text-title-m font-medium text-ink mb-2">{f.title}</h3>
              <p class="text-[0.875rem] text-ink-2 leading-relaxed">{f.desc}</p>
            </>
          )}
        </article>
      ))}
    </div>

    {moreCaps.length > 0 && (
      <div class="mt-12 pt-8 border-t border-line reveal" data-delay="12">
        <span class="text-label font-mono text-ink-3 uppercase">{t.features.moreLabel}</span>
        <ul class="flex flex-wrap gap-x-6 gap-y-2.5 mt-4">
          {alwaysChips.map((c) => (
            <li class="text-[0.8125rem] text-ink-2 flex items-center gap-2">
              <span class="w-1 h-1 rounded-full bg-accent/60" aria-hidden="true"></span>
              {c.title}
            </li>
          ))}
          {features.filter((f) => f.priority >= 5).map((f) => (
            <li class={`${chipVisFor(f.priority)} flex text-[0.8125rem] text-ink-2 items-center gap-2`}>
              <span class="w-1 h-1 rounded-full bg-accent/60" aria-hidden="true"></span>
              {f.title}
            </li>
          ))}
          {moreCaps.map((cap: string) => (
            <li class="text-[0.8125rem] text-ink-2 flex items-center gap-2">
              <span class="w-1 h-1 rounded-full bg-accent/60" aria-hidden="true"></span>
              {cap}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

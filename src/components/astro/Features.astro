---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: 'en' | 'zh';
}
const { locale = 'en' } = Astro.props;
const t = locale === 'zh' ? translations.zh : translations.en;

const features = [
  { title: t.features.organizeTitle, tag: t.features.organizeTag, desc: t.features.organizeDesc, icon: 'layers' },
  { title: t.features.bidirectionalTitle, tag: t.features.bidirectionalTag, desc: t.features.bidirectionalDesc, icon: 'link-2' },
  { title: t.features.conversationalTitle, tag: t.features.conversationalTag, desc: t.features.conversationalDesc, icon: 'message-square' },
  { title: t.features.autoMaintenanceTitle, tag: t.features.autoMaintenanceTag, desc: t.features.autoMaintenanceDesc, icon: 'refresh-cw' },
];
---

<section id="features" class="relative w-full py-28 sm:py-36">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-14 reveal">
      <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">{t.features.label}</span>
      <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-[#e5e5e5] reveal" data-delay="1">{t.features.title}</h2>
      <p class="text-obsidian-muted max-w-lg text-sm">{t.features.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {features.map((f, i) => (
        <div class="feature-card group rounded-xl border border-obsidian-border bg-obsidian-card/60 overflow-hidden hover:border-obsidian-purple/30 hover:bg-white/[0.05] glow-hover transition-all duration-300 reveal" data-delay={i * 2}>
          <div class="p-5 sm:p-6">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-8 h-8 rounded-lg bg-obsidian-purple/15 border border-obsidian-purple/25 flex items-center justify-center">
                <Icon name={f.icon} class="w-4 h-4 text-obsidian-purple-light" />
              </div>
              <span class="text-[10px] font-mono text-obsidian-purple tracking-wider uppercase">{f.tag}</span>
            </div>
            <h3 class="text-base font-semibold text-obsidian-heading mb-2">{f.title}</h3>
            <p class="text-sm text-obsidian-muted leading-relaxed mb-3">{f.desc}</p>

            <!-- Micro code snippet -->
            <div class="rounded-md bg-obsidian-bg border border-obsidian-border px-3 py-2 font-mono text-xs text-obsidian-dim">
              {i === 0 && (
                <div>
                  <span class="text-obsidian-amber">sources/</span>article.md<br/>
                  <span class="text-obsidian-muted">  ↓ (auto)</span><br/>
                  <span class="text-obsidian-purple">wiki/</span>entities/...<br/>
                  <span class="text-obsidian-purple">wiki/</span>concepts/...
                </div>
              )}
              {i === 1 && (
                <div>
                  <span class="text-obsidian-purple">[[Page A]]</span> ↔ <span class="text-obsidian-purple">[[Page B]]</span><br/>
                  <span class="text-obsidian-muted">  auto-linked</span><br/>
                  <span class="text-obsidian-muted">  graph grows</span>
                </div>
              )}
              {i === 2 && (
                <div>
                  <span class="text-obsidian-muted">Ask:</span> "How does X relate to Y?"<br/>
                  <span class="text-obsidian-purple">  → [[X]]</span> + [[Y]] cited<br/>
                  <span class="text-obsidian-muted">  → saved as wiki page</span>
                </div>
              )}
              {i === 3 && (
                <div>
                  <span class="text-obsidian-muted">file watcher</span>: ON<br/>
                  <span class="text-obsidian-muted">lint</span>: weekly<br/>
                  <span class="text-obsidian-muted">health check</span>: startup<br/>
                  <span class="text-obsidian-muted">  (default: OFF)</span>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const tMap: Record<string, any> = translations; const t = tMap[locale] || translations.en;

// Features grid — 8 cards total. By device:
//   mobile  (< sm): priority 1-4  (4 cards, 1 col)
//   sm+     (sm+):  priority 1-8  (8 cards, 2 cols × 4 rows on sm / 4 cols × 2 rows on md+)
// Cards demoted at larger breakpoints are surfaced as chips in the row below,
// styled identically to the "more capabilities" pills. Bidirectional links is
// a chip on all sizes (always demoted from v1.23 onward — the live-link
// behavior is now a transitive property of citations + multi-file + history).
const features = [
  { title: t.features.organizeTitle, tag: t.features.organizeTag, desc: t.features.organizeDesc, icon: 'layers', priority: 1 },
  { title: t.features.conversationalTitle, tag: t.features.conversationalTag, desc: t.features.conversationalDesc, icon: 'message-square', priority: 2 },
  { title: t.features.autoMaintenanceTitle, tag: t.features.autoMaintenanceTag, desc: t.features.autoMaintenanceDesc, icon: 'refresh-cw', priority: 3 },
  { title: t.features.smartFixTitle, tag: t.features.smartFixTag, desc: t.features.smartFixDesc, icon: 'zap', priority: 4 },
  { title: t.features.multiFileTitle, tag: t.features.multiFileTag, desc: t.features.multiFileDesc, icon: 'files', priority: 5 },
  { title: t.features.citationsTitle, tag: t.features.citationsTag, desc: t.features.citationsDesc, icon: 'quote', priority: 6 },
  // PDF Ingest (v1.25.0) — first-class source alongside Markdown.
  { title: t.features.pdfIngestTitle, tag: t.features.pdfIngestTag, desc: t.features.pdfIngestDesc, icon: 'file-text', priority: 7 },
  // Finalized — user-owned content stays user-owned.
  { title: t.features.finalizedTitle, tag: t.features.finalizedTag, desc: t.features.finalizedDesc, icon: 'lock', priority: 8 },
];

// Bidirectional links + history + granularity + tags: always chips (never a card).
// Bidirectional / history / granularity demoted to chip-only in v1.23 / v1.25.0;
// `tags` demoted to chip in v1.25.3-web when the Features grid shrunk to 8 cards.
// `perTaskModelsTitle` (v1.24.0) is EN-only; if the locale doesn't supply
// it, we silently skip the chip.
const alwaysChips: { title: string; tag: string }[] = [
  { title: t.features.bidirectionalTitle, tag: t.features.bidirectionalTag },
  { title: t.features.historyTitle, tag: t.features.historyTag },
  { title: t.features.granularityTitle, tag: t.features.granularityTag },
  { title: t.features.tagsTitle, tag: t.features.tagsTag },
];
if (t.features.perTaskModelsTitle) {
  alwaysChips.push({ title: t.features.perTaskModelsTitle, tag: '' });
}

const moreCaps = t.features.moreCapabilities || [];

// Card visibility — only one breakpoint split now (mobile 4 / sm+ 8).
const visFor = (p: number): string => (p <= 4 ? '' : 'hidden sm:block');
// Chip visibility — the inverse; demoted cards appear as chips on mobile only.
const chipVisFor = (p: number): string => (p <= 4 ? 'hidden' : 'sm:hidden');
---

<section id="features" class="relative w-full py-28 sm:py-36 reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-14 reveal text-center">
      <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">{t.features.label}</span>
      <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-obsidian-heading reveal" data-delay="1">{t.features.title}</h2>
      <p class="text-obsidian-muted max-w-lg mx-auto text-sm">{t.features.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
      {features.map((f) => (
        <div class={`feature-card group rounded-xl overflow-hidden card card-hover reveal ${visFor(f.priority)}`} data-delay={f.priority * 2}>
          <div class="p-5 sm:p-6">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-8 h-8 rounded-lg bg-obsidian-purple/15 border border-obsidian-purple/25 flex items-center justify-center">
                <Icon name={f.icon} class="w-4 h-4 text-obsidian-purple-light" />
              </div>
              <span class="text-[10px] font-mono text-obsidian-purple tracking-wider uppercase">{f.tag}</span>
            </div>
            <h3 class="text-base font-semibold text-obsidian-heading mb-2">{f.title}</h3>
            <p class="text-sm text-obsidian-muted leading-relaxed">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>

    {moreCaps.length > 0 && (
      <div class="mt-10 text-center reveal" data-delay="12">
        <span class="text-sm text-obsidian-dim">{t.features.moreLabel}</span>
        <div class="flex flex-wrap gap-2.5 sm:gap-3 justify-center mt-3 max-w-2xl mx-auto">
          {/* Bidirectional + history: always chips */}
          {alwaysChips.map((c) => (
            <span class="text-xs sm:text-sm px-3 py-1.5 sm:px-5 sm:py-2.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light">
              {c.title}
            </span>
          ))}
          {/* Demoted feature titles: chip on mobile, card from sm up */}
          {features.filter((f) => f.priority >= 5).map((f) => (
            <span class={`${chipVisFor(f.priority)} text-xs sm:text-sm px-3 py-1.5 sm:px-5 sm:py-2.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light`}>
              {f.title}
            </span>
          ))}
          {/* More capabilities chips */}
          {moreCaps.map((cap: string) => (
            <span class="text-xs sm:text-sm px-3 py-1.5 sm:px-5 sm:py-2.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light">{cap}</span>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
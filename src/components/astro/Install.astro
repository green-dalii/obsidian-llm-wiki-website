---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: 'en' | 'zh';
}
const { locale = 'en' } = Astro.props;
const t = locale === 'zh' ? translations.zh : translations.en;

function renderTagged(text: string): string {
  if (!text) return "";

  // First pass: replace <i> tags with SVG icons
  let processed = text.replace(/<i>(.*?)<\/i>/g, (match, iconName) => {
    if (iconName === 'folder') {
      return `<svg class="w-3 h-3 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>`;
    }
    if (iconName === 'refresh-cw') {
      return `<svg class="w-3 h-3 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>`;
    }
    return iconName;
  });

  // Second pass: replace <em> tags with badge spans (now icons are already SVG)
  processed = processed.replace(/<em>(.*?)<\/em>/g, (match, content) => {
    return `<span class="text-[9px] font-mono px-1 py-px rounded bg-obsidian-purple/15 text-obsidian-purple-light border border-obsidian-purple/25 whitespace-nowrap inline-flex items-center gap-1">${content}</span>`;
  });

  return processed;
}

const STEP_META = [
  { num: '01', icon: 'download', hasButton: true },
  { num: '02', icon: 'folder-open', hasButton: false },
  { num: '03', icon: 'settings', hasButton: false },
  { num: '04', icon: 'terminal', hasButton: false },
];
---

<section id="install" class="relative w-full py-24 sm:py-32">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-12 text-center reveal">
      <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">{t.install.label}</span>
      <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-obsidian-heading reveal" data-delay="1">{t.install.title}</h2>
      <p class="text-obsidian-muted text-sm max-w-lg mx-auto">{t.install.subtitle}</p>
    </div>

    <div class="flex flex-col gap-4">
      {STEP_META.map((s, idx) => (
        <div class="install-step relative rounded-xl overflow-hidden flex flex-col lg:flex-row card card-hover reveal" data-delay={idx * 2}>
          <!-- Illustration -->
          <div class="w-full lg:w-3/4 p-4 lg:p-5 border-b lg:border-b-0 lg:border-r border-obsidian-border/50 bg-obsidian-bg/50">
            {idx === 0 && (
              <svg viewBox="0 0 280 160" class="w-full h-auto" aria-hidden="true">
                <rect x="4" y="4" width="272" height="152" rx="8" fill="#1f1f1f" stroke="#333" stroke-width="1"/>
                <rect x="4" y="4" width="272" height="28" rx="8" fill="#1a1a1a"/>
                <rect x="4" y="14" width="272" height="18" rx="0" fill="#1a1a1a"/>
                <circle cx="22" cy="18" r="3" fill="#ef4444" opacity="0.6"/>
                <circle cx="34" cy="18" r="3" fill="#f59e0b" opacity="0.6"/>
                <circle cx="46" cy="18" r="3" fill="#22c55e" opacity="0.6"/>
                <rect x="62" y="12" width="200" height="12" rx="4" fill="#1f1f1f" stroke="#333" stroke-width="0.5"/>
                <text x="66" y="21" fill="#737373" font-size="5.5" font-family="JetBrains Mono, monospace">github.com/green-dalii/obsidian-llm-wiki/releases</text>
                <rect x="24" y="48" width="232" height="28" rx="5" fill="#1f1f1f" stroke="#333" stroke-width="1"/>
                <rect x="32" y="55" width="14" height="14" rx="3" fill="#d97706" opacity="0.15"/>
                <text x="52" y="65" fill="#e5e5e5" font-size="8" font-family="JetBrains Mono, monospace">main.js</text>
                <rect x="220" y="55" width="28" height="14" rx="3" fill="#7c3aed" opacity="0.2"/>
                <text x="232" y="65" fill="#8b5cf6" font-size="9" font-family="JetBrains Mono, monospace">↓</text>
                <rect x="24" y="84" width="232" height="28" rx="5" fill="#1f1f1f" stroke="#333" stroke-width="1"/>
                <rect x="32" y="91" width="14" height="14" rx="3" fill="#7c3aed" opacity="0.15"/>
                <text x="52" y="101" fill="#e5e5e5" font-size="8" font-family="JetBrains Mono, monospace">manifest.json</text>
                <rect x="220" y="91" width="28" height="14" rx="3" fill="#7c3aed" opacity="0.2"/>
                <text x="232" y="101" fill="#8b5cf6" font-size="9" font-family="JetBrains Mono, monospace">↓</text>
                <rect x="24" y="120" width="232" height="28" rx="5" fill="#1f1f1f" stroke="#333" stroke-width="1"/>
                <rect x="32" y="127" width="14" height="14" rx="3" fill="#22c55e" opacity="0.15"/>
                <text x="52" y="137" fill="#e5e5e5" font-size="8" font-family="JetBrains Mono, monospace">styles.css</text>
                <rect x="220" y="127" width="28" height="14" rx="3" fill="#7c3aed" opacity="0.2"/>
                <text x="232" y="137" fill="#8b5cf6" font-size="9" font-family="JetBrains Mono, monospace">↓</text>
              </svg>
            )}
            {idx === 1 && (
              <svg viewBox="0 0 280 160" class="w-full h-auto" aria-hidden="true">
                <defs>
                  <clipPath id="sidebarClipInstall">
                    <path d="M12,4 H88 V156 H12 A8,8,0,0,1,4,148 V12 A8,8,0,0,1,12,4 Z"/>
                  </clipPath>
                </defs>
                <rect x="4" y="4" width="272" height="152" rx="8" fill="#1f1f1f" stroke="#333" stroke-width="1"/>
                <rect x="4" y="4" width="84" height="152" fill="#1a1a1a" clip-path="url(#sidebarClipInstall)"/>
                <text x="16" y="28" fill="#737373" font-size="6" font-family="system-ui">General</text>
                <text x="16" y="44" fill="#737373" font-size="6" font-family="system-ui">Editor</text>
                <text x="16" y="60" fill="#737373" font-size="6" font-family="system-ui">Files</text>
                <rect x="12" y="68" width="68" height="18" rx="3" fill="#7c3aed" opacity="0.12"/>
                <text x="16" y="80" fill="#8b5cf6" font-size="6" font-family="system-ui" font-weight="600">Community plugins</text>
                <text x="100" y="24" fill="#e5e5e5" font-size="8" font-family="system-ui" font-weight="600">Installed plugins</text>
                <rect x="100" y="38" width="72" height="18" rx="4" fill="#1a1a1a" stroke="#333" stroke-width="0.5"/>
                <text x="112" y="50" fill="#a3a3a3" font-size="6" font-family="system-ui">↻ Refresh</text>
                <rect x="180" y="38" width="72" height="18" rx="4" fill="#1a1a1a" stroke="#333" stroke-width="0.5"/>
                <g transform="translate(189, 44) scale(0.38)" fill="none" stroke="#a3a3a3" stroke-width="2.1">
                  <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
                </g>
                <text x="204" y="50" fill="#a3a3a3" font-size="6" font-family="system-ui">Open folder</text>
                <rect x="100" y="66" width="160" height="78" rx="5" fill="#1a1a1a" stroke="#2e2e2e" stroke-width="0.5"/>
                <rect x="108" y="76" width="144" height="26" rx="4" fill="#1a1a1a" stroke="#333" stroke-width="0.5"/>
                <rect x="114" y="83" width="12" height="12" rx="3" fill="#7c3aed" opacity="0.2"/>
                <text x="132" y="92" fill="#e5e5e5" font-size="7" font-family="system-ui" font-weight="500">Karpathy LLM Wiki</text>
                <rect x="224" y="82" width="22" height="12" rx="6" fill="#7c3aed"/>
                <circle cx="240" cy="88" r="4" fill="#fff"/>
              </svg>
            )}
            {idx === 2 && (
              <svg viewBox="0 0 280 160" class="w-full h-auto" aria-hidden="true">
                <defs>
                  <clipPath id="sidebarClipConfig">
                    <path d="M12,4 H88 V156 H12 A8,8,0,0,1,4,148 V12 A8,8,0,0,1,12,4 Z"/>
                  </clipPath>
                </defs>
                <rect x="4" y="4" width="272" height="152" rx="8" fill="#1f1f1f" stroke="#333" stroke-width="1"/>
                <rect x="4" y="4" width="84" height="152" fill="#1a1a1a" clip-path="url(#sidebarClipConfig)"/>
                <text x="16" y="28" fill="#737373" font-size="6" font-family="system-ui">Community plugins</text>
                <rect x="12" y="36" width="68" height="18" rx="3" fill="#7c3aed" opacity="0.12"/>
                <text x="16" y="48" fill="#8b5cf6" font-size="6" font-family="system-ui" font-weight="600">Karpathy LLM Wiki</text>
                <text x="100" y="24" fill="#e5e5e5" font-size="8" font-family="system-ui" font-weight="600">LLM Provider Configuration</text>
                <text x="100" y="46" fill="#a3a3a3" font-size="6" font-family="system-ui">Provider</text>
                <rect x="100" y="52" width="152" height="20" rx="4" fill="#1a1a1a" stroke="#333" stroke-width="0.5"/>
                <text x="108" y="65" fill="#e5e5e5" font-size="7" font-family="JetBrains Mono, monospace">DeepSeek ▾</text>
                <text x="100" y="86" fill="#a3a3a3" font-size="6" font-family="system-ui">API Key</text>
                <rect x="100" y="92" width="152" height="20" rx="4" fill="#1a1a1a" stroke="#333" stroke-width="0.5"/>
                <text x="108" y="105" fill="#737373" font-size="7" font-family="JetBrains Mono, monospace">sk-••••••••••••••••••</text>
                <rect x="100" y="124" width="72" height="18" rx="4" fill="#1a1a1a" stroke="#333" stroke-width="0.5"/>
                <text x="136" y="136" text-anchor="middle" fill="#a3a3a3" font-size="6" font-family="system-ui">Fetch Models</text>
                <rect x="180" y="124" width="72" height="18" rx="4" fill="#7c3aed" opacity="0.2" stroke="#7c3aed" stroke-width="0.5"/>
                <text x="216" y="136" text-anchor="middle" fill="#8b5cf6" font-size="6" font-family="system-ui" font-weight="500">Test Connection</text>
              </svg>
            )}
            {idx === 3 && (
              <svg viewBox="0 0 280 160" class="w-full h-auto" aria-hidden="true">
                <rect x="0" y="0" width="280" height="160" rx="8" fill="#0a0a0a" opacity="0.3"/>
                <rect x="20" y="28" width="240" height="110" rx="8" fill="#1f1f1f" stroke="#333" stroke-width="1"/>
                <rect x="24" y="32" width="232" height="26" rx="5" fill="#1a1a1a" stroke="#333" stroke-width="0.5"/>
                <text x="36" y="49" fill="#e5e5e5" font-size="9" font-family="JetBrains Mono, monospace">&gt; Ingest</text>
                <rect x="86" y="38" width="1" height="14" rx="0.5" fill="#7c3aed">
                  <animate attributeName="opacity" values="1;0;1" dur="1s" repeatCount="indefinite"/>
                </rect>
                <rect x="24" y="64" width="232" height="22" rx="4" fill="#7c3aed" opacity="0.1" stroke="#7c3aed" stroke-width="0.5"/>
                <text x="36" y="79" fill="#e5e5e5" font-size="7" font-family="system-ui" font-weight="500">Ingest single source</text>
                <text x="164" y="79" fill="#737373" font-size="6" font-family="system-ui">Select a note</text>
                <rect x="24" y="90" width="232" height="20" rx="4" fill="#1f1f1f"/>
                <text x="36" y="103" fill="#a3a3a3" font-size="7" font-family="system-ui">Ingest from folder</text>
                <text x="164" y="103" fill="#525252" font-size="6" font-family="system-ui">Pick any folder</text>
                <rect x="24" y="114" width="232" height="20" rx="4" fill="#1f1f1f"/>
                <text x="36" y="127" fill="#a3a3a3" font-size="7" font-family="system-ui">Query wiki</text>
                <text x="164" y="127" fill="#525252" font-size="6" font-family="system-ui">Ask questions</text>
                <rect x="196" y="138" width="56" height="14" rx="3" fill="#7c3aed" opacity="0.12" stroke="#7c3aed" stroke-width="0.8" stroke-opacity="0.8"/>
                <text x="201" y="148" fill="#8b5cf6" font-size="6" font-family="JetBrains Mono, monospace">⌘+P / Ctrl+P</text>
              </svg>
            )}
          </div>
          <!-- Content -->
          <div class="w-full lg:w-1/4 p-4 lg:p-5 flex flex-col justify-center">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-7 h-7 rounded-md bg-obsidian-purple/10 border border-obsidian-purple/20 flex items-center justify-center">
                <Icon name={s.icon} class="w-3.5 h-3.5 text-obsidian-purple-light" />
              </div>
              <span class="text-[10px] font-mono text-obsidian-dim">{s.num}</span>
            </div>
            <h3 class="text-base font-semibold text-[#e5e5e5] mb-1.5">{t.install[`step${idx + 1}Title` as keyof typeof t.install]}</h3>
            <p class="text-xs text-obsidian-muted leading-relaxed" set:html={renderTagged(t.install[`step${idx + 1}Desc` as keyof typeof t.install])} />
            {s.hasButton && (
              <a href="https://github.com/green-dalii/obsidian-llm-wiki/releases" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 px-4 py-2 text-xs font-medium text-white bg-obsidian-purple-dark rounded-lg hover:bg-obsidian-purple transition-colors w-fit">
                <Icon name="download" class="w-3.5 h-3.5" />
                {t.install.cta}
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

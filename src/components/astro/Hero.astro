---
import { translations } from '../../i18n/astro';
import HeroBackgroundIsland from '../HeroBackgroundIsland';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const tMap: Record<string, any> = translations; const t = tMap[locale] || translations.en;
---

<section class="relative min-h-[calc(100svh-3.5rem)] w-full overflow-hidden flex flex-col">
  <!-- Canvas background - lazy load -->
  <div class="absolute inset-y-0 right-0 z-0 w-full lg:w-[64%]">
    <HeroBackgroundIsland client:idle />
  </div>

  <!-- Fade the graph into the type column so it never competes with the headline. -->
  <div class="pointer-events-none absolute inset-y-0 left-0 z-0 w-full lg:w-[58%] bg-gradient-to-r from-canvas via-canvas/85 to-transparent" aria-hidden="true"></div>

  <!-- Copy sits on the baseline, not in the middle of the viewport. A centred
       hero is the default shape of every page in this category; anchoring the
       block low gives the graph above it room to be read. -->
  <div class="relative z-10 flex-1 w-full max-w-[1180px] mx-auto px-6 sm:px-8 pt-32 pb-12 flex flex-col justify-end">
    <div class="hero-fade mb-7" style="--i:0">
      <a
        href="https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-line bg-surface/70 backdrop-blur-sm text-[11px] font-mono tracking-wide text-ink-2 hover:text-ink hover:border-line-strong transition-colors duration-200"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {t.hero.badge}
      </a>
    </div>

    <h1 class="font-display text-display-xl text-ink max-w-[16ch] mb-7">
      <span class="hero-line" style="--i:1"><span>{t.hero.title1}</span></span>
      <span class="hero-line" style="--i:2"><span>{t.hero.title2}</span></span>
    </h1>

    <p class="hero-fade text-[1.0625rem] text-ink-2 max-w-[52ch] leading-relaxed mb-9" style="--i:3">
      {t.hero.subtitle}
    </p>

    <div class="hero-fade flex flex-wrap items-center gap-3 mb-9" style="--i:4">
      <a href="https://community.obsidian.md/plugins/karpathywiki" target="_blank" rel="noopener noreferrer"
        data-magnetic
        class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-md bg-accent-solid text-accent-ink font-medium text-sm transition-[filter,transform] duration-200 hover:brightness-110 active:scale-[0.99]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/>
        </svg>
        {t.hero.ctaInstall}
      </a>
      <a href="https://obsidian.md/download" target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md border border-line text-ink-2 text-sm font-medium hover:text-ink hover:border-line-strong transition-colors duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        {t.hero.ctaObsidian}
      </a>
      <span class="text-[11px] font-mono text-ink-3 ml-1">{t.hero.obsidianHint}</span>
    </div>

    <!-- Foot rule: the hairline carries the wayfinding, not a floating pill. -->
    <div class="hero-fade flex items-end justify-between gap-6 pt-5 border-t border-line" style="--i:5">
      <span class="flex items-center gap-2.5 text-[10px] font-mono text-ink-3 tracking-[0.18em] uppercase">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {t.hero.scrollHint}
      </span>
      <span class="hidden sm:block text-[10px] font-mono text-ink-3 tracking-[0.14em]">
        Obsidian · MIT · v1.29
      </span>
    </div>
  </div>
</section>

<style>
  /* Each line rises out of its own mask in reading order. The mask is what
     makes it read as typeset rather than faded in. Ordering comes from an
     explicit --i, not from nth-of-type, which is unreliable across the mixed
     element siblings in this block. */
  .hero-line {
    overflow: hidden;
    display: block;
  }

  .hero-line > * {
    display: block;
    animation: hero-rise 0.95s var(--ease-entrance) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  .hero-fade {
    animation: hero-fade 0.85s var(--ease-entrance) both;
    animation-delay: calc(var(--i, 0) * 90ms + 120ms);
  }

  @keyframes hero-rise {
    from { transform: translateY(105%); }
    to { transform: translateY(0); }
  }

  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line > *,
    .hero-fade {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

---
import { translations } from '../../i18n/astro';
import HeroBackgroundIsland from '../HeroBackgroundIsland';

interface Props {
  locale?: 'en' | 'zh';
}
const { locale = 'en' } = Astro.props;
const t = locale === 'zh' ? translations.zh : translations.en;
---

<section class="relative h-[calc(100dvh-3.5rem)] w-full flex items-center justify-center overflow-hidden">
  <!-- Canvas background - lazy load -->
  <div class="absolute inset-0 z-0">
    <HeroBackgroundIsland client:visible="react" />
  </div>

  <!-- Static content - SSR -->
  <div class="relative z-10 text-center px-6 max-w-3xl mx-auto hero-content">
    <!-- Badge -->
    <div class="hero-item inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-obsidian-border bg-obsidian-card/80 backdrop-blur-sm mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-obsidian-purple opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-obsidian-purple"></span>
      </span>
      <a href="https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-obsidian-muted tracking-wide hover:text-obsidian-heading transition-colors">
        {t.hero.badge}
      </a>
    </div>

    <!-- Title -->
    <h1 class="hero-item text-[clamp(2.5rem,6vw,4.5rem)] font-semibold tracking-tight text-obsidian-heading leading-[1.1] mb-6">
      {t.hero.title1}
      <br />
      <span class="text-obsidian-purple-light">{t.hero.title2}</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-item text-lg text-obsidian-muted max-w-xl mx-auto mb-10 leading-relaxed">
      {t.hero.subtitle}
    </p>

    <!-- CTA buttons -->
    <div class="hero-item flex flex-col items-center gap-4">
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="https://github.com/green-dalii/obsidian-llm-wiki/releases" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-lg bg-obsidian-purple-dark hover:bg-obsidian-purple text-white font-medium text-sm transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          {t.hero.ctaInstall}
        </a>
        <a href="https://obsidian.md/download" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-obsidian-border text-obsidian-muted text-sm font-medium hover:text-obsidian-heading hover:border-obsidian-border-light transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          {t.hero.ctaObsidian}
        </a>
      </div>
      <span class="hero-item text-xs text-obsidian-dim text-center">{t.hero.obsidianHint}</span>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 opacity-40">
    <span class="text-[10px] font-mono text-obsidian-muted tracking-[0.2em] uppercase">{t.hero.scrollHint}</span>
    <div class="w-px h-6 bg-gradient-to-b from-obsidian-muted to-transparent"></div>
  </div>
</section>

<style>
  /* Hero entrance animation - CSS alternative to GSAP */
  .hero-content {
    opacity: 0;
    animation: hero-fade-in 0.9s ease-out 0.4s forwards;
  }

  .hero-item {
    opacity: 0;
    transform: translateY(28px);
    animation: hero-item-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-item:nth-child(1) { animation-delay: 0.4s; }
  .hero-item:nth-child(2) { animation-delay: 0.52s; }
  .hero-item:nth-child(3) { animation-delay: 0.64s; }
  .hero-item:nth-child(4) { animation-delay: 0.76s; }
  .hero-item:nth-child(5) { animation-delay: 0.88s; }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes hero-item-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: 'en' | 'zh';
}
const { locale = 'en' } = Astro.props;
const t = locale === 'zh' ? translations.zh : translations.en;
---

<section id="comparison" class="relative w-full py-28 sm:py-36 reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-12 text-center">
      <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">{t.comparison.label}</span>
      <div class="mb-8">
        <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-obsidian-heading reveal" data-delay="1">{t.comparison.title}</h2>
        <p class="text-obsidian-muted text-sm max-w-md mx-auto reveal" data-delay="2">{t.comparison.subtitle}</p>
      </div>
    </div>

    <!-- Desktop header -->
    <div class="hidden md:grid grid-cols-2 gap-4 mb-3">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-obsidian-dim" />
        <span class="text-xs font-mono text-obsidian-dim uppercase tracking-wider">{t.comparison.beforeLabel}</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-obsidian-purple" />
        <span class="text-xs font-mono text-obsidian-purple-light uppercase tracking-wider">{t.comparison.afterLabel}</span>
      </div>
    </div>

    <div class="space-y-4">
      {t.comparison.items.map((item, i) => (
        <div class="compare-row grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4 group reveal" data-delay={i * 2}>
          <!-- Before -->
          <div class="rounded-lg p-4 md:p-5 opacity-70 card card-hover">
            <div class="flex items-center gap-2 mb-2.5 md:hidden">
              <span class="text-[10px] font-mono text-obsidian-dim uppercase tracking-wider">{t.comparison.beforeLabel}</span>
              <span class="text-[10px] font-mono text-obsidian-muted">— {item.category}</span>
            </div>
            <div class="hidden md:flex items-center gap-2 mb-2.5">
              <Icon name="x" class="w-3.5 h-3.5 text-obsidian-dim flex-shrink-0" />
              <span class="text-xs font-mono text-obsidian-dim">{item.category}</span>
              {i === 0 && <Icon name="bookmark" class="w-3 h-3 text-obsidian-dim ml-auto" />}
              {i === 1 && <Icon name="link-2" class="w-3 h-3 text-obsidian-dim ml-auto" />}
              {i === 2 && <Icon name="trending-up" class="w-3 h-3 text-obsidian-dim ml-auto" />}
            </div>
            <p class="text-sm text-obsidian-dim leading-relaxed">{item.before}</p>
          </div>

          <!-- After -->
          <div class="rounded-lg p-4 md:p-5 relative overflow-hidden card-purple">
            <div class="flex items-center gap-2 mb-2.5 md:hidden">
              <span class="text-[10px] font-mono text-obsidian-purple-light uppercase tracking-wider">{t.comparison.afterLabel}</span>
              <span class="text-[10px] font-mono text-obsidian-muted">— {item.category}</span>
            </div>
            <div class="hidden md:flex items-center gap-2 mb-2.5">
              <Icon name="check" class="w-3.5 h-3.5 text-obsidian-purple-light flex-shrink-0" />
              <span class="text-xs font-mono text-obsidian-purple-light">{item.category}</span>
              {i === 0 && <Icon name="bookmark" class="w-3 h-3 text-obsidian-purple-light ml-auto" />}
              {i === 1 && <Icon name="link-2" class="w-3 h-3 text-obsidian-purple-light ml-auto" />}
              {i === 2 && <Icon name="trending-up" class="w-3 h-3 text-obsidian-purple-light ml-auto" />}
            </div>
            <p class="text-sm text-obsidian-muted leading-relaxed">{item.after}</p>
            <div class="absolute top-0 right-0 w-20 h-20 bg-obsidian-purple/5 rounded-full blur-2xl" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
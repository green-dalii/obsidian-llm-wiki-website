---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const tMap: Record<string, any> = translations; const t = tMap[locale] || translations.en;
---

<section id="comparison" class="relative w-full py-section-std reveal">
  <div class="max-w-[1180px] mx-auto px-6 sm:px-8">
    <div class="mb-12">
      <span class="text-label font-mono text-accent uppercase">{t.comparison.label}</span>
      <div class="mb-8">
        <h2 class="text-display-l font-display mt-3 mb-4 text-ink reveal" data-delay="1">{t.comparison.title}</h2>
        <p class="text-ink-2 max-w-[46ch] text-[0.9375rem] reveal" data-delay="2">{t.comparison.subtitle}</p>
      </div>
    </div>

    <!-- Desktop column headers -->
    <div class="hidden md:grid grid-cols-2 gap-10 mb-4">
      <div class="flex items-center gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-ink-3"></span>
        <span class="text-label font-mono text-ink-3 uppercase">{t.comparison.beforeLabel}</span>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        <span class="text-label font-mono text-accent uppercase">{t.comparison.afterLabel}</span>
      </div>
    </div>

    <!-- The spine is the section's argument: on the left, three isolated
         items; on the right, the same three things joined. It draws itself as
         the section scrolls, which is the one place on the page where the
         connector motif is allowed to perform. -->
    <div class="relative">
      <div class="hidden md:block absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-line-strong spine" aria-hidden="true"></div>

      <div class="space-y-3 md:space-y-5">
        {t.comparison.items.map((item, i) => (
          <div class="compare-row relative grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-10 group reveal" data-delay={i * 2}>
            <!-- Node on the spine, one per row -->
            <span class="hidden md:block absolute left-1/2 top-6 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-accent ring-4 ring-canvas z-10" aria-hidden="true"></span>

            <!-- Before: isolated. No card, just a rule — nothing here connects. -->
            <div class="md:pr-10 md:text-right border-l-2 border-line md:border-l-0 pl-4 md:pl-0 py-1">
              <div class="flex items-center gap-2 mb-2 md:justify-end">
                <span class="text-label font-mono text-ink-3 uppercase md:hidden">{t.comparison.beforeLabel}</span>
                <span class="text-label font-mono text-ink-3 uppercase">{item.category}</span>
                <Icon name="x" class="w-3 h-3 text-ink-3" />
              </div>
              <p class="text-[0.9375rem] text-ink-3 leading-relaxed">{item.before}</p>
            </div>

            <!-- After: joined. -->
            <div class="md:pl-10 py-1">
              <div class="flex items-center gap-2 mb-2">
                <Icon name="check" class="w-3 h-3 text-accent" />
                <span class="text-label font-mono text-accent uppercase">{item.category}</span>
                <span class="text-label font-mono text-ink-3 uppercase md:hidden">{t.comparison.afterLabel}</span>
              </div>
              <p class="text-[0.9375rem] text-ink leading-relaxed">{item.after}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Scroll-linked where the engine supports it; a plain hairline everywhere
     else. No JavaScript, and the reduced-motion guard resolves it fully drawn. */
  .spine {
    transform-origin: top center;
  }

  @supports (animation-timeline: view()) {
    .spine {
      animation: spine-draw linear both;
      animation-timeline: view();
      animation-range: entry 8% cover 60%;
    }
  }

  @keyframes spine-draw {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .spine {
      animation: none;
      transform: none;
    }
  }
</style>

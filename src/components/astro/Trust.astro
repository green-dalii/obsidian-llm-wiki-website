---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const tMap: Record<string, any> = translations;
const t = tMap[locale] || translations.en;
// Trust is a new block — fall back to English until other locales are translated.
const tr = t.trust || translations.en.trust;
---

<section id="trust" class="relative w-full py-20 sm:py-28 reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-12 reveal text-center">
      <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">{tr.label}</span>
      <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-obsidian-heading reveal" data-delay="1">{tr.title}</h2>
      <p class="text-obsidian-muted text-sm max-w-lg mx-auto">{tr.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {tr.items.map((item: { title: string; desc: string; icon: string }, i: number) => (
        <div class="trust-card group rounded-xl p-6 card card-hover reveal" data-delay={i * 2}>
          <div class="w-10 h-10 rounded-lg bg-obsidian-purple/15 border border-obsidian-purple/25 flex items-center justify-center mb-4 group-hover:bg-obsidian-purple/20 transition-colors">
            <Icon name={item.icon} class="w-5 h-5 text-obsidian-purple-light" />
          </div>
          <h3 class="text-base font-semibold text-obsidian-heading mb-2">{item.title}</h3>
          <p class="text-sm text-obsidian-muted leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

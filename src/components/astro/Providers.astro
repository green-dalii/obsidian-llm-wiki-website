---
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const tMap: Record<string, any> = translations; const t = tMap[locale] || translations.en;
const tp = { ...translations.en.providers, ...t.providers };

// Twelve providers — twelve cards, four rows of three on desktop, three
// rows of four at md+. The first card is the recommendation (DeepSeek =
// best value for the wiki use case); the rest are grouped by deployment
// shape — cloud flagship → cloud budget → enterprise / VPC → local →
// aggregator / custom endpoint. Brand names first; version numbers
// never. Note: DeepSeek is independent (backed by High-Flyer, NOT
// Alibaba). Qwen is Alibaba.
//
// Composition history (do not re-litigate without a reason):
//   v1.27.0-web — retired the generic "OpenAI-Compatible" slot to make room
//                 for AWS Bedrock (Claude / GPT stay reachable via any custom
//                 OpenAI- or Anthropic-protocol endpoint).
//   v1.29.0-web — added "ChatGPT Plan" (Codex OAuth), a distinct *sign-in*
//                 rather than another endpoint: your ChatGPT subscription
//                 instead of a separately-billed API key. It has shipped since
//                 plugin v1.25.2 and had never appeared on this page, while the
//                 enterprise equivalent (Bedrock SSO) has been here since
//                 v1.27.0-web. Retired "Anthropic-Compatible" to keep twelve:
//                 of the previous twelve it was the only card that is a
//                 configuration path rather than a provider, and the section
//                 subtitle already promises "or your own endpoint".
//                 "OpenCode (Zen / Go)" — a new preset in v1.28.0 — is
//                 deliberately NOT here: it is an aggregator that overlaps
//                 OpenRouter, and its real user value (a streamed answer that
//                 survives a blocked origin) belongs in the blog post, not a
//                 grid cell.
const PROVIDERS = [
  { name: 'DeepSeek', tagline: 'DeepSeek' },
  { name: 'Anthropic', tagline: 'Claude' },
  { name: 'OpenAI', tagline: 'GPT' },
  { name: 'ChatGPT Plan', tagline: 'Sign in, no API key' },
  { name: 'Google', tagline: 'Gemini / Gemma' },
  { name: 'xAI', tagline: 'Grok' },
  { name: 'Qwen', tagline: 'Alibaba' },
  { name: 'Kimi', tagline: 'Moonshot' },
  { name: 'GLM', tagline: 'Zhipu' },
  { name: 'AWS Bedrock', tagline: 'Claude / GPT in your VPC' },
  { name: 'OpenRouter', tagline: 'Any model' },
  { name: 'Ollama + LM Studio', tagline: 'Local', local: true },
];
---

<section id="providers" class="relative w-full py-20 sm:py-28 reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 reveal">
      <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">{tp.label}</span>
      <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-obsidian-heading reveal" data-delay="1">{tp.title}</h2>
      <p class="text-obsidian-muted text-sm max-w-lg mx-auto">{tp.subtitle}</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5">
      {PROVIDERS.map((p, i) => (
        <div class="provider-card group p-3.5 rounded-lg card card-hover reveal flex items-center justify-between gap-2" data-delay={2 + i}>
          <div class="min-w-0">
            <div class="text-sm font-medium text-[#e5e5e5] truncate">{p.name}</div>
            <div class="text-[10px] font-mono text-obsidian-dim leading-tight truncate">{p.tagline}</div>
          </div>
          {p.badge === 'bestValue' && (
            <span class="shrink-0 text-[9px] font-mono px-1.5 py-0.5 rounded bg-obsidian-purple/15 text-obsidian-purple-light border border-obsidian-purple/25">{tp.bestValue}</span>
          )}
          {p.local && (
            <span class="shrink-0 text-[9px] font-mono px-1.5 py-0.5 rounded bg-obsidian-bg text-obsidian-dim border border-obsidian-border">{tp.localBadge}</span>
          )}
        </div>
      ))}
    </div>

    <div class="mt-6 flex items-start gap-2.5 p-3 rounded-lg border border-obsidian-purple/20 bg-obsidian-purple/[0.04] reveal" data-delay={15}>
      <Icon name="lightbulb" class="w-4 h-4 text-obsidian-purple-light shrink-0 mt-0.5" />
      <p class="text-xs text-obsidian-muted leading-relaxed min-w-0">{tp.contextNote}</p>
    </div>

    <!-- Deep link to plugin repo's MODEL-GUIDE for the full tiered provider table + PDF-OCR-GUIDE. -->
    <div class="mt-4 text-center reveal" data-delay="16">
      <a href="https://github.com/green-dalii/obsidian-llm-wiki/blob/main/docs/MODEL-GUIDE.md" target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-[11px] text-obsidian-purple-light hover:text-obsidian-heading transition-colors">
        {tp.modelGuideLink}
        <Icon name="external-link" class="w-3 h-3" />
      </a>
    </div>
  </div>
</section>
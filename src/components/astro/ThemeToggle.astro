---
/**
 * Theme control — three states: follow the OS, force light, force dark.
 *
 * The value is owned by the inline script in BaseLayout (which runs before
 * first paint so there is no flash); this component only renders the control
 * and forwards presses to `window.__klwTheme`.
 *
 * Labels are kept local rather than added to `types.ts`: they are three words,
 * and threading them through the i18n contract would make 11 locale files
 * change for a control that lives in one place.
 */
interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;

type Mode = 'auto' | 'light' | 'dark';

const LABELS: Record<string, Record<Mode, string>> = {
  en: { auto: 'Follow system', light: 'Light', dark: 'Dark' },
  zh: { auto: '跟随系统', light: '浅色', dark: '深色' },
  'zh-tw': { auto: '跟隨系統', light: '淺色', dark: '深色' },
  ja: { auto: 'システムに合わせる', light: 'ライト', dark: 'ダーク' },
  ko: { auto: '시스템 설정', light: '라이트', dark: '다크' },
  de: { auto: 'Systemeinstellung', light: 'Hell', dark: 'Dunkel' },
  es: { auto: 'Seguir el sistema', light: 'Claro', dark: 'Oscuro' },
  fr: { auto: 'Suivre le système', light: 'Clair', dark: 'Sombre' },
  pt: { auto: 'Seguir o sistema', light: 'Claro', dark: 'Escuro' },
  it: { auto: 'Segui il sistema', light: 'Chiaro', dark: 'Scuro' },
  ru: { auto: 'Как в системе', light: 'Светлая', dark: 'Тёмная' },
};

const labels = LABELS[locale] ?? LABELS.en;
const modes: Mode[] = ['auto', 'light', 'dark'];
---

<div class="theme-toggle" role="group" aria-label={labels.auto + ' / ' + labels.light + ' / ' + labels.dark}>
  {modes.map((mode) => (
    <button
      type="button"
      class="theme-toggle__btn"
      data-theme-mode={mode}
      aria-label={labels[mode]}
      title={labels[mode]}
      aria-pressed="false"
    >
      {mode === 'auto' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none" />
        </svg>
      )}
      {mode === 'light' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
      )}
      {mode === 'dark' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      )}
    </button>
  ))}
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background-color: var(--surface-2);
  }

  .theme-toggle__btn {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    color: var(--ink-3);
    transition:
      color 0.16s var(--ease-state),
      background-color 0.16s var(--ease-state);
  }

  .theme-toggle__btn svg {
    width: 13px;
    height: 13px;
  }

  .theme-toggle__btn:hover {
    color: var(--ink);
  }

  /* The pressed state is a hairline-framed surface, not a filled pill. */
  .theme-toggle__btn[aria-pressed='true'] {
    color: var(--accent);
    background-color: var(--surface);
    box-shadow: inset 0 0 0 1px var(--accent-line);
  }
</style>

<script>
  type Mode = 'auto' | 'light' | 'dark';

  interface KlwTheme {
    mode: Mode;
    set: (next: Mode) => void;
  }

  const getApi = (): KlwTheme | undefined =>
    (window as unknown as { __klwTheme?: KlwTheme }).__klwTheme;

  function sync(): void {
    const mode = getApi()?.mode ?? 'auto';
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle__btn').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeMode === mode));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = btn.dataset.themeMode as Mode | undefined;
      if (!next) return;
      getApi()?.set(next);
      sync();
    });
  });

  // The OS can flip scheme while `auto` is selected; keep the control honest.
  window.addEventListener('klw:themechange', sync);
  sync();
</script>

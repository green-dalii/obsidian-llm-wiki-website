---
import { translations } from '../../i18n/astro';

interface Props {
  locale?: 'en' | 'zh';
}
const { locale = 'en' } = Astro.props;
const t = locale === 'zh' ? translations.zh : translations.en;
---

<section class="relative w-full py-20 sm:py-28 reveal">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="p-10 sm:p-14 text-center card card-hover">
      <h2 class="text-[clamp(1.4rem,3vw,2rem)] font-semibold text-[#e5e5e5] mb-3">
        {t.cta.title}
      </h2>
      <p class="text-obsidian-muted text-sm max-w-lg mx-auto mb-8">
        {t.cta.subtitle}
      </p>
      <a
        href="https://community.obsidian.md/plugins/karpathywiki"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium text-white bg-obsidian-purple-dark rounded-lg hover:bg-obsidian-purple transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
        {t.cta.button}
      </a>
    </div>
  </div>
</section>

---
import { translations } from '../../i18n/astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const tMap: Record<string, any> = translations; const t = tMap[locale] || translations.en;

// The closing statement. No card: a bordered box made the last thing on the
// page the most contained one, which is backwards. This is the largest type on
// the site and it sits directly on the page surface.
---

<section class="relative w-full py-section-major reveal">
  <div class="max-w-[1180px] mx-auto px-6 sm:px-8">
    <div class="border-t border-line pt-14 sm:pt-20 flex flex-col md:flex-row md:items-end md:justify-between gap-10">
      <div class="max-w-[22ch]">
        <h2 class="text-display-l font-display text-ink">
          {t.cta.title}
        </h2>
        <p class="text-ink-2 text-[0.9375rem] max-w-[42ch] mt-5">
          {t.cta.subtitle}
        </p>
      </div>

      <a
        href="https://community.obsidian.md/plugins/karpathywiki"
        target="_blank"
        rel="noopener noreferrer"
        class="group shrink-0 inline-flex items-center gap-3 px-6 py-3.5 text-sm font-medium text-accent-ink bg-accent-solid rounded-md transition-[filter,transform] duration-200 hover:brightness-110 active:scale-[0.99]"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
        {t.cta.button}
        <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </div>
</section>

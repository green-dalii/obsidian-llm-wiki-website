---
import { Icon as AstroIcon } from 'astro-icon/components';

export interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

/**
 * Short-name → `lucide:*` icon mapping.
 *
 * All Astro templates (Features, Install, Comparison, etc.) use short names
 * like `layers`, `search`, `check`. This map resolves them to lucide icons.
 * Unknown names pass through verbatim so you can use `lucide:foo` directly.
 */
const ICON_MAP: Record<string, string> = {
  // Features
  layers: 'lucide:layers',
  'message-square': 'lucide:message-square',
  files: 'lucide:files',
  'refresh-cw': 'lucide:refresh-cw',
  zap: 'lucide:zap',
  lock: 'lucide:lock',
  quote: 'lucide:quote',
  tag: 'lucide:tag',
  sliders: 'lucide:sliders',
  // PDF Ingest (v1.25.0)
  'file-text': 'lucide:file-text',

  // Comparison
  x: 'lucide:x',
  bookmark: 'lucide:bookmark',
  'link-2': 'lucide:link-2',
  'trending-up': 'lucide:trending-up',
  check: 'lucide:check',

  // Ecosystem
  network: 'lucide:network',
  download: 'lucide:download',
  'table-2': 'lucide:table-2',
  'git-branch': 'lucide:git-branch',
  monitor: 'lucide:monitor',

  // Install
  search: 'lucide:search',
  settings: 'lucide:settings',
  terminal: 'lucide:terminal',
  'external-link': 'lucide:external-link',

  // LatestBlog
  'arrow-right': 'lucide:arrow-right',

  // Providers
  wallet: 'lucide:wallet',
  'code-2': 'lucide:code-2',
  lightbulb: 'lucide:lightbulb',
};

const iconName = ICON_MAP[name] || name;

if (!name) {
  throw new Error('Icon.astro: name prop is required');
}
if (name && !ICON_MAP[name]) {
  console.warn(`Icon.astro: unknown short name "${name}" — passed through as-is (use lucide:xxx for direct names)`);
}
---

<AstroIcon name={iconName} class={className || ''} />

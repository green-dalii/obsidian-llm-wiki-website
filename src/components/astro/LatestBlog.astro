---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { translations } from '../../i18n/astro';

export interface Props {
  locale?: string;
  title?: string;
  subtitle?: string;
  cta?: string;
}

const { locale = 'en', title, subtitle, cta } = Astro.props;

const tMap: Record<string, any> = translations;
const t = tMap[locale] || translations.en;
const bl = t.latestBlog ?? { label: 'Blog', title: 'Latest from the blog', subtitle: '', cta: 'See all posts', readMore: 'Read more' };

// Locale-aware date formatting — map locale code to Intl locale
const DATE_LOCALE: Record<string, string> = {
  en: 'en-US',
  zh: 'zh-CN',
  'zh-tw': 'zh-TW',
  ja: 'ja-JP',
  ko: 'ko-KR',
  de: 'de-DE',
  es: 'es-ES',
  fr: 'fr-FR',
  pt: 'pt-PT',
  it: 'it-IT',
  ru: 'ru-RU',
};
const dateLocale = DATE_LOCALE[locale] || 'en-US';

// Blog content only exists in EN and ZH; non-ZH locales show EN content.
const isZh = locale === 'zh';
const sectionTitle = title ?? bl.title;
const sectionSubtitle = subtitle ?? bl.subtitle;
const ctaText = cta ?? bl.cta;
const readMoreText = bl.readMore;
const blogPath = isZh ? '/zh/blog/' : '/blog/';
const postsPath = isZh ? '/zh/blog/posts/' : '/blog/posts/';

const collection = isZh ? 'blog-zh' : 'blog';
const posts = (await getCollection(collection))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3) as CollectionEntry<'blog'>[];
---

{posts.length > 0 && (
  <section class="relative w-full py-28 sm:py-36 reveal">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-14 reveal">
        <div class="reveal">
          <span class="text-[11px] font-mono text-obsidian-purple tracking-[0.15em] uppercase">{bl.label}</span>
          <h2 class="text-[clamp(1.6rem,4vw,2.8rem)] font-semibold mt-3 mb-3 text-obsidian-heading reveal" data-delay="1">{sectionTitle}</h2>
          <p class="text-obsidian-muted max-w-lg text-sm">{sectionSubtitle}</p>
        </div>
        <a href={blogPath} class="group inline-flex items-center gap-1.5 text-sm text-obsidian-purple-light hover:text-obsidian-heading transition-colors reveal" data-delay="2">
          {ctaText}
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {posts.map((post, i) => {
          const postDate = new Date(post.data.date);
          const firstTag = post.data.tags?.[0];
          return (
            <article class="card card-hover group rounded-xl overflow-hidden reveal flex flex-col" data-delay={(i + 1) * 2}>
              <div class="p-5 sm:p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 text-xs text-obsidian-dim mb-3">
                  <time datetime={postDate.toISOString()}>
                    {postDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  {firstTag && (
                    <>
                      <span>·</span>
                      <span class="text-obsidian-purple-light">{firstTag}</span>
                    </>
                  )}
                </div>
                <h3 class="text-base font-semibold text-obsidian-heading mb-2">
                  <a href={`${postsPath}${post.id}/`} class="hover:text-obsidian-purple-light transition-colors">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-obsidian-muted leading-relaxed line-clamp-3 mb-4 flex-1">{post.data.description}</p>
                <div class="flex items-center text-xs text-obsidian-dim mt-auto">
                  <a href={`${postsPath}${post.id}/`} class="group/link inline-flex items-center text-obsidian-purple-light hover:text-obsidian-heading transition-colors">
                    {readMoreText}
                    <Icon name="arrow-right" class="w-3.5 h-3.5 ml-1 group-hover/link:translate-x-0.5 transition-transform" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

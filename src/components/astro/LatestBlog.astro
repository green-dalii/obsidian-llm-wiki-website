---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

export interface Props {
  locale?: string;
  title?: string;
  subtitle?: string;
  cta?: string;
}

const { locale = 'en', title, subtitle, cta } = Astro.props;

const isZh = locale === 'zh';
const sectionTitle = title ?? (isZh ? '最新博客' : 'Latest from the blog');
const sectionSubtitle = subtitle ?? (isZh ? '深入架构、工作流与模型选型' : 'Deep dives on architecture, workflows, and model selection.');
const ctaText = cta ?? (isZh ? '查看全部 →' : 'See all posts →');
const blogPath = isZh ? '/zh/blog/' : '/blog/';
const postsPath = isZh ? '/zh/blog/posts/' : '/blog/posts/';

const collection = isZh ? 'blog-zh' : 'blog';
const posts = (await getCollection(collection))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

{posts.length > 0 && (
  <section class="py-16 sm:py-24" aria-labelledby="latest-blog-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-semibold text-obsidian-purple-light uppercase tracking-wider">{isZh ? '博客' : 'Blog'}</span>
          <h2 id="latest-blog-heading" class="text-2xl sm:text-3xl font-semibold text-obsidian-heading mt-2">{sectionTitle}</h2>
          <p class="text-obsidian-muted mt-2 max-w-xl">{sectionSubtitle}</p>
        </div>
        <a href={blogPath} class="inline-flex items-center gap-1.5 text-sm text-obsidian-purple-light hover:text-obsidian-heading transition-colors">
          {ctaText}
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map(post => {
          const postDate = new Date(post.data.date);
          return (
            <article class="group flex flex-col bg-obsidian-surface border border-obsidian-border rounded-xl p-5 hover:border-obsidian-purple/30 transition-colors">
              <div class="flex items-center gap-2 text-xs text-obsidian-dim mb-3">
                <time datetime={postDate.toISOString()}>
                  {postDate.toLocaleDateString(isZh ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <>
                    <span>·</span>
                    <span class="text-obsidian-purple-light">{post.data.tags[0]}</span>
                  </>
                )}
              </div>
              <h3 class="text-lg font-medium text-obsidian-heading group-hover:text-obsidian-purple-light transition-colors mb-2">
                <a href={`${postsPath}${post.id}/`} class="focus:outline-none">
                  <span class="absolute inset-0" aria-hidden="true" />
                  {post.data.title}
                </a>
              </h3>
              <p class="text-sm text-obsidian-muted line-clamp-3 mb-4 flex-1">{post.data.description}</p>
              <div class="flex items-center text-xs text-obsidian-dim mt-auto">
                <span class="group-hover:text-obsidian-purple-light transition-colors">{isZh ? '阅读更多' : 'Read more'}</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5 ml-1 group-hover:translate-x-0.5 transition-transform" />
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

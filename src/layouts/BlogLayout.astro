---
import BaseLayout from './BaseLayout.astro';

const { title, description = '', locale = 'en' } = Astro.props;
---

<BaseLayout title={title} description={description} locale={locale} ogLocale={locale === 'zh' ? 'zh_CN' : 'en_US'} isBlog>
  <slot />
</BaseLayout>

<script src="../scripts/scroll-reveal.ts"></script>

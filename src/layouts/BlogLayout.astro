---
import BaseLayout from './BaseLayout.astro';
import { OG_LOCALE_MAP } from '../i18n/astro';

const { title, description = '', locale = 'en', hreflangAlternates, breadcrumbs } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  ogLocale={OG_LOCALE_MAP[locale] ?? 'en_US'}
  isBlog
  hreflangAlternates={hreflangAlternates}
  breadcrumbs={breadcrumbs}
>
  <slot />
</BaseLayout>

<script src="../scripts/scroll-reveal.ts"></script>

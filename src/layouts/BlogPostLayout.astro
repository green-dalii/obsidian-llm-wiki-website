---
import BaseLayout from './BaseLayout.astro';

const { title, description } = Astro.props;
const locale = Astro.props.locale || 'en';
const rawDate = Astro.props.date;
const dt = rawDate instanceof Date ? rawDate : new Date(rawDate as string);
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const formattedDate = dt.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
const tags = (Astro.props.tags || []) as string[];
const relatedPosts = (Astro.props.relatedPosts || []) as { slug: string; title: string }[];
const headings = (Astro.props.headings || []) as { depth: number; slug: string; text: string }[];
const backLabel = locale === 'zh' ? '返回博客' : 'Back to Blog';
const blogPath = locale === 'zh' ? '/zh/blog/' : '/blog/';
const tocLabel = locale === 'zh' ? '目录' : 'Contents';
const relatedLabel = locale === 'zh' ? '接下来读什么' : 'What to Read Next';
const tf = locale === 'zh' ? '/zh/blog/' : '/blog/';
---

<BaseLayout title={title} description={description} locale={locale} ogLocale={locale === 'zh' ? 'zh_CN' : 'en_US'}>
  <main class="pt-14">
    <article class="relative w-full py-16 sm:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <a href={blogPath} class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors mb-8">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          {backLabel}
        </a>

        <div class="flex flex-col lg:flex-row gap-8">
          <!-- Left TOC -->
          <aside class="hidden lg:block lg:w-56 lg:flex-shrink-0">
            <div class="sticky top-24">
              <h4 class="text-xs font-semibold text-obsidian-heading uppercase tracking-wider mb-3">{tocLabel}</h4>
              <nav class="text-sm space-y-1.5" id="toc-nav">
                {headings.map(h => (
                  <a href={'#' + h.slug} class={'block text-obsidian-muted hover:text-obsidian-heading py-0.5 text-[13px] leading-snug toc-link ' + (h.depth === 2 ? 'pl-0' : 'pl-3')} data-target={h.slug}>{h.text}</a>
                ))}
              </nav>
            </div>
          </aside>

          <!-- Center -->
          <div class="flex-1 min-w-0 max-w-3xl mx-auto lg:mx-0">
            <header class="mb-10">
              <time class="text-sm font-mono text-obsidian-dim block mb-2">{formattedDate}</time>
              <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-semibold text-obsidian-heading leading-tight mb-4">{title}</h1>
              <p class="text-obsidian-muted leading-relaxed">{description}</p>
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {tags.map(tag => (
                    <a href={`${tf}?tag=${encodeURIComponent(tag)}`} class="text-[10px] px-2 py-0.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light hover:bg-obsidian-purple/20 transition-colors">{tag}</a>
                  ))}
                </div>
              )}
            </header>
            <div class="prose prose-invert max-w-none">
              <slot />
            </div>

            {relatedPosts.length > 0 && (
              <div class="lg:hidden mt-16 pt-6 border-t border-obsidian-border">
                <h4 class="text-sm font-semibold text-obsidian-heading mb-3">{relatedLabel}</h4>
                <div class="flex flex-col gap-2">
                  {relatedPosts.map(r => (
                    <a href={locale === 'zh' ? `/zh/blog/posts/${r.slug}/` : `/blog/posts/${r.slug}/`} class="group inline-flex items-center gap-2 text-sm text-obsidian-muted hover:text-obsidian-heading transition-colors"><span class="text-obsidian-purple opacity-60">→</span> {r.title}</a>
                  ))}
                </div>
              </div>
            )}
            <div class="lg:hidden mt-4">
              <a href={blogPath} class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                {backLabel}
              </a>
            </div>
          </div>

          <!-- Right Related -->
          {relatedPosts.length > 0 && (
            <aside class="hidden lg:block lg:w-56 lg:flex-shrink-0">
              <div class="sticky top-24">
                <h4 class="text-xs font-semibold text-obsidian-heading uppercase tracking-wider mb-3">{relatedLabel}</h4>
                <div class="flex flex-col gap-2.5">
                  {relatedPosts.map(r => (
                    <a href={locale === 'zh' ? `/zh/blog/posts/${r.slug}/` : `/blog/posts/${r.slug}/`} class="group text-sm text-obsidian-muted hover:text-obsidian-heading transition-colors leading-snug"><span class="text-obsidian-purple opacity-60 group-hover:opacity-100 transition-opacity mr-1">→</span> {r.title}</a>
                  ))}
                </div>
              </div>
            </aside>
          )}
        </div>
      </div>
    </article>
  </main>

  <Fragment slot="head">
    <script is:inline>
    (function(){var a=document.querySelectorAll('.toc-link');if(!a.length)return;var b=[];a.forEach(function(l){var e=document.getElementById(l.dataset.target);if(e)b.push(e)});window.addEventListener('scroll',function(){var p=window.scrollY+120,active=-1;b.forEach(function(e,i){if(e.offsetTop<=p)active=i});a.forEach(function(l,i){l.classList.toggle('text-obsidian-purple-light',i===active);l.classList.toggle('font-medium',i===active)})},{passive:true});a.forEach(function(l){l.addEventListener('click',function(e){e.preventDefault();var t=document.getElementById(l.dataset.target);if(t){t.scrollIntoView({behavior:'smooth',block:'start'});history.replaceState(null,'','#'+l.dataset.target)}})})})();
    </script>
  </Fragment>
</BaseLayout>

<style>
.prose { --tw-prose-links: #a78bfa; }
.prose a { text-decoration: underline; text-underline-offset: 3px; }
.prose a:hover { color: #c4b5fd; }
.prose code { background: rgba(124,58,237,0.12); padding: 0.15rem 0.4rem; border-radius: 4px; }
.prose pre { border: 1px solid #333; border-radius: 8px; }
.prose pre code { background: none; padding: 0; }
.prose blockquote { border-left-width: 3px; font-style: normal; }
.prose img { border-radius: 8px; }
</style>

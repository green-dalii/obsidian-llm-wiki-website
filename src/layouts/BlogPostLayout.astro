---
import HeaderIsland from '../components/HeaderIsland';
import Footer from '../components/astro/Footer.astro';
import ProgressBar from '../components/ProgressBar';
import '../index.css';

const { title, description } = Astro.props;
const rawDate = Astro.props.date;
const formattedDate = rawDate ? (rawDate instanceof Date ? rawDate : new Date(rawDate)).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
const tags = Astro.props.tags || [];
const siteUrl = Astro.site;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — LLM Wiki Blog</title>
    <meta name="description" content={description} />
    <meta name="author" content="Greener-Dalii" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1a1a1a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Karpathy LLM Wiki" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + 'og-image.webp'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </head>
  <body>
    <div class="relative bg-obsidian-bg text-obsidian-text">
      <ProgressBar client:only="react" />
      <HeaderIsland client:only="react" currentLocale="en" isBlog />
      <main class="pt-14">
        <article class="relative w-full py-16 sm:py-24">
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors mb-8">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              Back to Blog
            </a>

            <header class="mb-10">
              <time class="text-sm font-mono text-obsidian-dim block mb-2">{formattedDate}</time>
              <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-semibold text-obsidian-heading leading-tight mb-4">{title}</h1>
              <p class="text-obsidian-muted leading-relaxed">{description}</p>
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {tags.map(tag => (
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light">{tag}</span>
                  ))}
                </div>
              )}
            </header>

            <div class="prose prose-invert prose-sm sm:prose max-w-none">
              <slot />
            </div>

            <div class="mt-16 pt-6 border-t border-obsidian-border">
              <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to Blog
              </a>
            </div>
          </div>
        </article>
      </main>
      <Footer locale="en" />
    </div>
  </body>
</html>

<script src="../scripts/scroll-reveal.ts"></script>

<style>
.prose h2 {
  font-size: 1.5rem;
  font-weight: 600;
  color: #e8e8e8;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
}
.prose h3 {
  font-size: 1.25rem;
  font-weight: 600;
  color: #e8e8e8;
  margin-top: 2rem;
  margin-bottom: 0.75rem;
}
.prose p {
  color: #a3a3a3;
  line-height: 1.7;
  margin-bottom: 1.25rem;
}
.prose strong { color: #e5e5e5; }
.prose ul, .prose ol { color: #a3a3a3; padding-left: 1.5rem; margin-bottom: 1.25rem; }
.prose li { margin-bottom: 0.5rem; }
.prose code { background: rgba(124,58,237,0.1); color: #a78bfa; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85em; }
.prose pre { background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 1rem; overflow-x: auto; margin-bottom: 1.5rem; }
.prose pre code { background: none; padding: 0; color: #d4d4d4; }
.prose a { color: #8b5cf6; text-decoration: underline; text-underline-offset: 2px; }
.prose a:hover { color: #a78bfa; }
.prose blockquote { border-left: 3px solid #7c3aed; padding-left: 1rem; color: #8a8a8a; margin: 1.5rem 0; }
.prose table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
.prose th, .prose td { border: 1px solid #333; padding: 0.5rem 0.75rem; text-align: left; }
.prose th { background: #1a1a1a; color: #e8e8e8; }
.prose td { color: #a3a3a3; }
.prose hr { border: none; border-top: 1px solid #1a1a1a; margin: 2rem 0; }
</style>

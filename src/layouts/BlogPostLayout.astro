---
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import ProgressBar from '../components/astro/ProgressBar.astro';
import '../index.css';

const { title, description } = Astro.props;
const locale = Astro.props.locale || 'en';
const rawDate = Astro.props.date;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const formattedDate = rawDate ? (rawDate instanceof Date ? rawDate : new Date(rawDate)).toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' }) : '';
const tags = Astro.props.tags || [];
const siteUrl = Astro.site;
const backLabel = locale === 'zh' ? '返回博客' : 'Back to Blog';
const blogPath = locale === 'zh' ? '/zh/blog/' : '/blog/';
const blogTitle = locale === 'zh' ? 'Karpathy LLM Wiki 博客' : 'Karpathy LLM Wiki Blog';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {blogTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Greener-Dalii" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1a1a1a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Karpathy LLM Wiki" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + 'og-image.webp'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </head>
  <body>
    <div class="relative bg-obsidian-bg text-obsidian-text">
      <ProgressBar />
      <Header currentLocale={locale} isBlog />
      <main class="pt-14">
        <article class="relative w-full py-16 sm:py-24">
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <a href={blogPath} class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors mb-8">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              {backLabel}
            </a>

            <header class="mb-10">
              <time class="text-sm font-mono text-obsidian-dim block mb-2">{formattedDate}</time>
              <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-semibold text-obsidian-heading leading-tight mb-4">{title}</h1>
              <p class="text-obsidian-muted leading-relaxed">{description}</p>
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {tags.map((tag: string) => (
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light">{tag}</span>
                  ))}
                </div>
              )}
            </header>

            <div class="prose prose-invert max-w-none">
              <slot />
            </div>

            <div class="mt-16 pt-6 border-t border-obsidian-border">
              <a href={blogPath} class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                {backLabel}
              </a>
            </div>
          </div>
        </article>
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>

<script src="../scripts/scroll-reveal.ts"></script>

<style>
/* Minimal overrides on top of @tailwindcss/typography prose-invert defaults */
.prose { --tw-prose-links: #a78bfa; }
.prose a { text-decoration: underline; text-underline-offset: 3px; }
.prose a:hover { color: #c4b5fd; }
.prose code { background: rgba(124,58,237,0.12); padding: 0.15rem 0.4rem; border-radius: 4px; }
.prose pre { border: 1px solid #333; border-radius: 8px; }
.prose pre code { background: none; padding: 0; }
.prose blockquote { border-left-width: 3px; font-style: normal; }
.prose img { border-radius: 8px; }
</style>

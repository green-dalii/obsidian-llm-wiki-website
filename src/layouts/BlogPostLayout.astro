---
import BaseLayout from './BaseLayout.astro';

const { title, description } = Astro.props;
const locale = Astro.props.locale || 'en';
const rawDate = Astro.props.date;
const dt = rawDate instanceof Date ? rawDate : new Date(rawDate as string);
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const formattedDate = dt.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
const tags = (Astro.props.tags || []) as string[];
const relatedPosts = (Astro.props.relatedPosts || []) as { slug: string; title: string }[];
const headings = (Astro.props.headings || []) as { depth: number; slug: string; text: string }[];
const backLabel = locale === 'zh' ? '返回博客' : 'Back to Blog';
const blogPath = locale === 'zh' ? '/zh/blog/' : '/blog/';
const tocLabel = locale === 'zh' ? '目录' : 'Contents';
const relatedLabel = locale === 'zh' ? '接下来读什么' : 'What to Read Next';
const tf = locale === 'zh' ? '/zh/blog/' : '/blog/';

// SEO: article structured data + breadcrumb trail + hreflang (passed from the route)
const hreflangAlternates = (Astro.props.hreflang || []) as { code: string; path: string }[];
const articleMeta = { datePublished: dt.toISOString(), tags };
const homePath = locale === 'zh' ? '/zh/' : '/';
const homeLabel = locale === 'zh' ? '首页' : 'Home';
const blogLabel = locale === 'zh' ? '博客' : 'Blog';
const breadcrumbs = [
  { name: homeLabel, path: homePath },
  { name: blogLabel, path: blogPath },
  { name: title, path: Astro.url.pathname },
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  ogLocale={locale === 'zh' ? 'zh_CN' : 'en_US'}
  isBlog
  pageType="article"
  articleMeta={articleMeta}
  hreflangAlternates={hreflangAlternates}
  breadcrumbs={breadcrumbs}
>
  <main class="pt-14">
    <article class="relative w-full py-16 sm:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <a href={blogPath} class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors mb-8">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          {backLabel}
        </a>

        <div class="flex flex-col lg:flex-row gap-8">
          <!-- Left TOC -->
          <aside class="hidden lg:block lg:w-56 lg:flex-shrink-0">
            <div class="sticky top-24">
              <h4 class="text-xs font-semibold text-obsidian-heading uppercase tracking-wider mb-3">{tocLabel}</h4>
              <nav class="text-sm space-y-1.5" id="toc-nav">
                {headings.map(h => (
                  <a href={'#' + h.slug} class={'block text-obsidian-muted hover:text-obsidian-heading py-0.5 text-[13px] leading-snug toc-link ' + (h.depth === 2 ? 'pl-0' : 'pl-3')}>{h.text}</a>
                ))}
              </nav>
            </div>
          </aside>

          <!-- Center -->
          <div class="flex-1 min-w-0 max-w-3xl mx-auto lg:mx-0">
            <header class="mb-10">
              <time class="text-sm font-mono text-obsidian-dim block mb-2">{formattedDate}</time>
              <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] font-semibold text-obsidian-heading leading-tight mb-4">{title}</h1>
              <p class="text-obsidian-muted leading-relaxed">{description}</p>
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {tags.map(tag => (
                    <a href={`${tf}?tag=${encodeURIComponent(tag)}`} class="text-[10px] px-2 py-0.5 rounded-full bg-obsidian-purple/10 border border-obsidian-purple/20 text-obsidian-purple-light hover:bg-obsidian-purple/20 transition-colors">{tag}</a>
                  ))}
                </div>
              )}
            </header>
            <div class="prose prose-invert max-w-none">
              <slot />
            </div>

            <!-- Article Footer Links -->
            <div class="mt-12 pt-8 border-t border-obsidian-border">
              <h4 class="text-xs font-semibold text-obsidian-heading uppercase tracking-wider mb-4">
                {locale === 'zh' ? '相关链接' : 'Links'}
              </h4>
              <a href="https://community.obsidian.md/plugins/karpathywiki" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-obsidian-purple/15 border border-obsidian-purple/30 text-obsidian-purple-light hover:bg-obsidian-purple/25 transition-colors text-sm font-medium mb-3">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                {locale === 'zh' ? '在 Obsidian 安装插件' : 'Install on Obsidian'}
              </a>
              <div class="flex flex-wrap gap-2">
                <a href="https://github.com/green-dalii/obsidian-llm-wiki" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md bg-obsidian-surface border border-obsidian-border text-obsidian-muted hover:text-obsidian-heading hover:border-obsidian-purple/30 transition-colors text-xs">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  GitHub
                </a>
                <a href="https://github.com/green-dalii/obsidian-llm-wiki/discussions" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md bg-obsidian-surface border border-obsidian-border text-obsidian-muted hover:text-obsidian-heading hover:border-obsidian-purple/30 transition-colors text-xs">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  {locale === 'zh' ? '反馈建议' : 'Discussions'}
                </a>
                <a href="https://github.com/green-dalii/obsidian-llm-wiki/issues" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md bg-obsidian-surface border border-obsidian-border text-obsidian-muted hover:text-obsidian-heading hover:border-obsidian-purple/30 transition-colors text-xs">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  {locale === 'zh' ? '问题 / Bug' : 'Issues'}
                </a>
              </div>
            </div>

            {relatedPosts.length > 0 && (
              <div class="lg:hidden mt-16 pt-6 border-t border-obsidian-border">
                <h4 class="text-sm font-semibold text-obsidian-heading mb-3">{relatedLabel}</h4>
                <div class="flex flex-col gap-2">
                  {relatedPosts.map(r => (
                    <a href={locale === 'zh' ? `/zh/blog/posts/${r.slug}/` : `/blog/posts/${r.slug}/`} class="group inline-flex items-center gap-2 text-sm text-obsidian-muted hover:text-obsidian-heading transition-colors"><span class="text-obsidian-purple opacity-60">→</span> {r.title}</a>
                  ))}
                </div>
              </div>
            )}
            <div class="lg:hidden mt-4">
              <a href={blogPath} class="inline-flex items-center gap-1.5 text-sm text-obsidian-dim hover:text-obsidian-heading transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                {backLabel}
              </a>
            </div>
          </div>

          <!-- Right Related -->
          {relatedPosts.length > 0 && (
            <aside class="hidden lg:block lg:w-56 lg:flex-shrink-0">
              <div class="sticky top-24">
                <h4 class="text-xs font-semibold text-obsidian-heading uppercase tracking-wider mb-3">{relatedLabel}</h4>
                <div class="flex flex-col gap-2.5">
                  {relatedPosts.map(r => (
                    <a href={locale === 'zh' ? `/zh/blog/posts/${r.slug}/` : `/blog/posts/${r.slug}/`} class="group text-sm text-obsidian-muted hover:text-obsidian-heading transition-colors leading-snug"><span class="text-obsidian-purple opacity-60 group-hover:opacity-100 transition-opacity mr-1">→</span> {r.title}</a>
                  ))}
                </div>
              </div>
            </aside>
          )}
        </div>
      </div>
    </article>
  </main>

  <Fragment slot="head">
    <style is:global>
      .prose h2, .prose h3, .prose h4 { scroll-margin-top: 80px; }
      .toc-link.active { color: #a78bfa; font-weight: 500; }
    </style>
    <script is:inline>
    document.addEventListener('DOMContentLoaded',function(){var l=document.querySelectorAll('.toc-link');if(!l.length)return;var h=[];l.forEach(function(a){var e=document.querySelector(a.getAttribute('href'));if(e)h.push(e)});if(!h.length)return;var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting){var n=e.target.getAttribute('id');l.forEach(function(e){e.classList.toggle('active',e.getAttribute('href')==='#'+n)})}})},{rootMargin:'-80px 0px -70% 0px'});h.forEach(function(e){o.observe(e)})})();
    </script>
  </Fragment>
</BaseLayout>

<style>
.prose { --tw-prose-links: #a78bfa; }
.prose a { text-decoration: underline; text-underline-offset: 3px; }
.prose a:hover { color: #c4b5fd; }
.prose code { background: rgba(124,58,237,0.12); padding: 0.15rem 0.4rem; border-radius: 4px; }
.prose pre { border: 1px solid #333; border-radius: 8px; }
.prose pre code { background: none; padding: 0; }
.prose blockquote { border-left-width: 3px; font-style: normal; }
.prose img { border-radius: 8px; }
html { scroll-behavior: smooth; }
</style>

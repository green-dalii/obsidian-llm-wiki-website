---
import HeaderIsland from '../components/HeaderIsland';
import Footer from '../components/astro/Footer.astro';
import ProgressBar from '../components/ProgressBar';
import '../index.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  locale?: string;
  ogLocale?: string;
}

const { title, description = '', keywords = '', locale = 'en', ogLocale = 'en_US' } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Greener-Dalii" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="application-name" content="LLM Wiki for Obsidian" />
    <meta name="apple-mobile-web-app-title" content="LLM Wiki for Obsidian" />
    <meta name="msapplication-TileColor" content="#1a1a1a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LLM Wiki for Obsidian" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={Astro.site + 'og-image.webp'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GreenerDalii" />
    <meta name="twitter:creator" content="@GreenerDalii" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={Astro.site + 'og-image.webp'} />

    <!-- Additional head content -->
    <slot name="head" />
  </head>
  <body>
    <div class="relative bg-obsidian-bg text-obsidian-text">
      <ProgressBar client:only="react" />
      <HeaderIsland client:only="react" currentLocale={locale} />
      <main class="pt-14">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>

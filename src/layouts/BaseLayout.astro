---
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import ProgressBar from '../components/astro/ProgressBar.astro';
import { translations } from '../i18n/astro';
import '../index.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  locale?: string;
  ogLocale?: string;
  isBlog?: boolean;
  /** 'website' (default) or 'article' for blog posts — drives og:type + BlogPosting schema */
  pageType?: 'website' | 'article';
  /** Article metadata for blog posts (ISO datePublished + tags) */
  articleMeta?: { datePublished: string; tags?: string[] };
  /** Explicit hreflang alternates (paths). When omitted, all locale homepages are emitted. */
  hreflangAlternates?: { code: string; path: string }[];
  /** Breadcrumb trail (paths). When omitted, no BreadcrumbList is emitted (e.g. homepages). */
  breadcrumbs?: { name: string; path: string }[];
  /** Emit FAQPage schema from this locale's translations.faq.items (homepages only). */
  hasFaq?: boolean;
  /** Emit HowTo schema from this locale's translations.install.step{1,2,3} (homepages only). */
  hasHowTo?: boolean;
  /** Alt text for the social share image. */
  ogImageAlt?: string;
}

const {
  title,
  description = '',
  keywords = '',
  locale = 'en',
  ogLocale = 'en_US',
  isBlog = false,
  pageType = 'website',
  articleMeta,
  hreflangAlternates,
  breadcrumbs,
  hasFaq = false,
  hasHowTo = false,
  ogImageAlt = '',
} = Astro.props;

const siteUrl = Astro.site!;

// Canonical is derived from the REAL page path, not from the locale.
// (Previously every sub-page mistakenly self-canonicalised to its locale homepage.)
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('og-image.webp', siteUrl).href;
const resolvedOgImageAlt = ogImageAlt || 'Karpathy LLM Wiki — AI-powered self-organizing knowledge for Obsidian';

const ALL_LOCALES = ['en', 'zh', 'ja', 'ko', 'de', 'es', 'fr', 'pt', 'it', 'ru', 'zh-tw'] as const;
const localePrefix = (code: string) => code === 'en' ? '' : `${code}/`;

// hreflang: explicit alternates for blog pages, full locale set for homepages.
const hreflangSource = hreflangAlternates ?? ALL_LOCALES.map(code => ({ code, path: '/' + localePrefix(code) }));
const hreflangEntries = hreflangSource.map(h => ({ code: h.code, href: new URL(h.path, siteUrl).href }));
const xDefaultHref = (hreflangEntries.find(h => h.code === 'en') ?? hreflangEntries[0])?.href ?? siteUrl.href;

const PERSON = { "@type": "Person", "name": "Greener-Dalii", "url": "https://github.com/green-dalii" };

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": siteUrl.href + "#website",
    "name": "Karpathy LLM Wiki",
    "url": siteUrl.href,
    "description": description,
    "publisher": { "@type": "Person", "name": "Greener-Dalii" }
  },
  {
    "@type": "SoftwareApplication",
    "@id": siteUrl.href + "#software",
    "name": "Karpathy LLM Wiki",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Cross-platform",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "license": "https://opensource.org/licenses/MIT",
    "author": PERSON,
    "codeRepository": "https://github.com/green-dalii/obsidian-llm-wiki",
    "downloadUrl": "https://community.obsidian.md/plugins/karpathywiki",
    "featureList": [
      "AI-powered entity and concept extraction from notes",
      "Bidirectional wiki-links between knowledge pages",
      "Conversational query with streaming Markdown and traceable citations",
      "Smart Fix All — one-click causality-ordered batch fix",
      "Cross-language duplicate detection and intelligent merge",
      "Multilingual Wiki output independent from the UI language",
      "Parallel page generation with configurable concurrency",
      "Auto-maintenance with file watcher and periodic lint",
      "Reviewed-page protection — finalized pages are never overwritten",
      "Contradiction detection across conflicting sources"
    ]
  }
];

if (breadcrumbs && breadcrumbs.length) {
  graph.push({
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": b.name,
      "item": new URL(b.path, siteUrl).href
    }))
  });
}

if (pageType === 'article' && articleMeta) {
  graph.push({
    "@type": "BlogPosting",
    "@id": canonical + "#article",
    "headline": title,
    "description": description,
    "datePublished": articleMeta.datePublished,
    "dateModified": articleMeta.datePublished,
    "author": PERSON,
    "publisher": { "@type": "Person", "name": "Greener-Dalii" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
    "image": ogImage,
    "inLanguage": locale,
    ...(articleMeta.tags && articleMeta.tags.length ? { "keywords": articleMeta.tags.join(', ') } : {})
  });
}

if (hasFaq) {
  const tMap = translations as Record<string, any>;
  const faqItems = ((tMap[locale] || tMap.en).faq.items) as { q: string; a: string }[];
  graph.push({
    "@type": "FAQPage",
    "mainEntity": faqItems.map(it => ({
      "@type": "Question",
      "name": it.q,
      "acceptedAnswer": { "@type": "Answer", "text": it.a }
    }))
  });
}

// HowTo schema: surfaces the 3 install steps in Google search results
// (rich result carousel) and helps AI engines extract actionable steps.
if (hasHowTo) {
  const tMap = translations as Record<string, any>;
  const ti = (tMap[locale] || tMap.en).install as {
    label: string;
    title: string;
    step1Title: string;
    step1Desc: string;
    step2Title: string;
    step2Desc: string;
    step3Title: string;
    step3Desc: string;
  };
  graph.push({
    "@type": "HowTo",
    "@id": canonical + "#howto",
    "name": ti.title,
    "description": `How to install and start using Karpathy LLM Wiki in Obsidian — three steps from install to your first wiki query.`,
    "totalTime": "PT3M",
    "tool": { "@type": "HowToTool", "name": "Obsidian" },
    "step": [
      { "@type": "HowToStep", "position": 1, "name": ti.step1Title, "text": ti.step1Desc },
      { "@type": "HowToStep", "position": 2, "name": ti.step2Title, "text": ti.step2Desc },
      { "@type": "HowToStep", "position": 3, "name": ti.step3Title, "text": ti.step3Desc },
    ]
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Greener-Dalii" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="application-name" content="Karpathy LLM Wiki" />
    <meta name="apple-mobile-web-app-title" content="Karpathy LLM Wiki" />
    <meta name="msapplication-TileColor" content="#1a1a1a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonical} />
    {hreflangEntries.map(h => (
      <link rel="alternate" hreflang={h.code} href={h.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Karpathy LLM Wiki" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {pageType === 'article' && articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.datePublished} />
        <meta property="article:author" content="Greener-Dalii" />
        {(articleMeta.tags || []).map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@GreenerDalii" />
    <meta name="twitter:creator" content="@GreenerDalii" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- Additional head content -->
    <slot name="head" />
  </head>
  <body>
    <div class="relative bg-obsidian-bg text-obsidian-text">
      <ProgressBar />
      <Header currentLocale={locale} isBlog={isBlog || (breadcrumbs && breadcrumbs.length > 0)} />
      <main class="pt-14">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>

<script src="../scripts/scroll-reveal.ts"></script>
